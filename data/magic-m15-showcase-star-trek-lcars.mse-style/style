		left:				{ popout_left() }
		top:				{ popout_top() }
		width:				{ popout_width() }
		height:				{ popout_height() }
		z index:			1000
		store in metadata:	true
	############################# Text box
	text:
		left:				110
		top:				{ 633 + chop_top() + body_font_vertical() }
		right:				692
		bottom:				{ 943 - chop_bot() - if reminder_box_is_visible() then 18 else 0 }

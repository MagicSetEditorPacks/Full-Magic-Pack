		left:				0
		top:				0
		width:				{ stylesheet.card_width }
		height:				{ stylesheet.card_height }
		z index:			210
		visible:			{ card.pt != "" }
		mask:				pt_border_mask.png
	alias bar:
		left:				0
		top:				0
		width:				{ stylesheet.card_width }
		height:				{ stylesheet.card_height }
		z index:			190
		visible:			{ card.alias != "" }
		render style:		image
		image:				{ color_blend(type: "alias", multicolor_blend: "black") }
	alias bar border:
		left:				0
		top:				0

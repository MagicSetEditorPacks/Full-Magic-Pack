## generate the gradient mask
leveler_multiply_mask := {
	text_top := card_style.text.top
	text_bottom := card_style.text.bottom
	
	mask := crop_image(
		"/magic-modules.mse-include/multiply/white.png",
		offset_x:0,
		offset_y:0,
		height: height,
		width: width,
		background_color: "white"
	)
	stripe_mask := leveler_stripes_mask()
	
	for x from start to end do (
		lv_top := if x == 0 then 0
			else text_top + (card_style.text.layout.separators[x-1] or else stylesheet.card_height)
		lv_bottom := if x == end then height
			else text_top + (card_style.text.layout.separators[x] or else stylesheet.card_width) + 1

		stripe_effect_mask := leveler_stripe_effect_mask(level:x+1)
		has_effect := type_of(stripe_effect_mask.image) == "image" or stripe_effect_mask.image != ""
		if has_effect then (
			lv_top := lv_top - stripe_effect_mask.top_offset
			lv_bottom := lv_bottom + stripe_effect_mask.bottom_offset
		)
		lv_top := to_int(lv_top)
		lv_bottom := to_int(lv_bottom)
		lv_height := lv_bottom - lv_top
		
		if lv_height > 0 then (
			cropped := crop_image(
				stripe_mask,
				height: lv_height,
				width: width,
				offset_x: 0,
				offset_y: lv_top
			)
			
			if has_effect then (
				## nine slice to the proper size
				stripe_effect_mask_image := nine_slice_image(
					stripe_effect_mask.image,
					height: lv_height,
					width: width,
					top: stripe_effect_mask.top_margin,
					bottom: stripe_effect_mask.bottom_margin,
					left: 0,
					right: 0,
				)
				cropped := set_mask(image:cropped, mask:stripe_effect_mask_image)
			)
			
			mask := insert_image(
				base_image: mask,
				inserted_image: set_alpha(cropped, alpha:(multi_scale[x+bump]/iterate)),
				offset_x: 0,
				offset_y: lv_top,
				widen: false
			)

			
		)
		"dummy return"
	)
	
	mask
}

	information_secondary_shift_with_pt_1 := { not styling.leveler}
	
	template_prefix :=
	[
		border:				"border/",
		card:				"card/",
		clearcard:			"clearcard/",
		pt:					"pt/",
		level:				"level/",
		crown:				"crown/",
		namebox:			"namebox/",
		noncrown:			"noncrown/",
		clearcrown:			"clearcrown/",
		alias:				"alias/",
		stamp:				"stamp/",
		nonstamp:			"nonstamp/",
		transforml:			"transform_left/",
		identity:			"/magic-modules.mse-include/indicators/",
		identity2:			"/magic-modules.mse-include/indicators/"
	]
	template_suffix :=
	[
		border:				".png",
		card:				"card.png",
		clearcard:			".png",
		pt:					"pt.png",
		level:				"card.png",
		crown:				".png",
		namebox:			"card.png",
		noncrown:			".png",
		clearcrown:			".png",
		alias:				"card.png",
		stamp:				".png",
		nonstamp:			".png",
		transforml:			".png",
		identity:			"identity.png",
		identity2:			"identity.png"
	]
	template :=			{ template_prefix[type] + input +									template_suffix[type] }
	land_template :=	{ template_prefix[type] + (if input == "a" then "c" else input) +	template_suffix[type] }
	
	color_blend :=		{ color_background(input: card.card_color, type: type, base_hybrid: card_hybrid, multicolor_blend: multicolor_blend, hybrid_blend: hybrid_blend, artifact_blend: artifact_blend) }@(multicolor_blend: "white", hybrid_blend: "white", artifact_blend: "white")
	
	pure_colors :=
	{
		sort_text(
			order: if card_is_wedge(input) then "(wbgur)" else "(wubrg)",
			(if chosen(card.card_color, choice:"white")	then "w") +
			(if chosen(card.card_color, choice:"blue")	then "u") +
			(if chosen(card.card_color, choice:"black")	then "b") +
			(if chosen(card.card_color, choice:"red")	then "r") +
			(if chosen(card.card_color, choice:"green")	then "g")
		)
	}
	pt_colors := { if styling.PT_color_scheme == "canon" then pt_colors_canon() else styling.PT_color_scheme }
	pt_colors_canon := { if contains(card.card_color, match: "hybrid") then "land" else "gold" }
	
	is_promo := { styling.promo }
	
	is_unsorted := { styling.remove_from_autocount }
	
	foil_mask_added_sections := { [] }
	foil_mask_removed_sections := { [] }
	
	chop_top :=			{ split := split_comma(styling.chop_text_box); if length(split) > 0 and split[0] != "" and split[0] != "-" then clamp(split[0], maximum:500, minimum:-500) else 0 }
	chop_bottom :=		{ split := split_comma(styling.chop_text_box); if length(split) > 1 and split[1] != "" and split[1] != "-" then clamp(split[1], maximum:500, minimum:-500) else 0 }
	chop_right :=		{ split := split_comma(styling.chop_text_box); if length(split) > 2 and split[2] != "" and split[2] != "-" then clamp(split[2], maximum:500, minimum:-500) else 0 }
	
	popout_left :=		{ split := split_comma(styling.popout_art_coordinates); if length(split) > 3 and split.0 != "" then clamp(split.0, maximum: 1500, minimum: -500) else 0 }
	popout_top :=		{ split := split_comma(styling.popout_art_coordinates); if length(split) > 3 and split.1 != "" then clamp(split.1, maximum: 2000, minimum: -500) else 0 }
	popout_width :=		{ split := split_comma(styling.popout_art_coordinates); if length(split) > 3 and split.2 != "" then clamp(split.2, maximum: 1500, minimum: 0) else 0 }
	popout_height :=	{ split := split_comma(styling.popout_art_coordinates); if length(split) > 3 and split.3 != "" then clamp(split.3, maximum: 2000, minimum: 0) else 0 }
	
	art_left :=			{ if styling.stretch_art_to_whole_card or styling.border != "yes"	then 0																	else 29 }
	art_width :=		{ if styling.stretch_art_to_whole_card or styling.border != "yes"	then stylesheet.card_width												else 687 }
	art_top :=			{ if styling.stretch_art_to_whole_card								then 0																	else 112 }
	art_bottom :=		{ if styling.stretch_art_to_whole_card								then stylesheet.card_height	else if textbox_alpha() <= 0.995 then 965	else 590 }
	art_mask :=			{ crop("image_" + (if textbox_alpha() <= 0.995 then "transparent_" else "") + "mask.png", offset_x: art_left(), offset_y: art_top(), width: art_width(), height: art_bottom() - art_top()) }
	
	textbox_alpha := { get_alpha_percentage(styling.textbox_opacity_percentage, default: 100) }
	textbox_top := { 669 + (if is_stamped() then 4 else 0) + chop_top() + body_font_vertical() }
	textbox_bottom := { 944 - (if reminder_box_is_visible() then 25 else if is_stamped() then 8 else 0) - chop_bottom() }
	textbox_leveler_height := { (textbox_bottom() - textbox_top()) / 3 }
	


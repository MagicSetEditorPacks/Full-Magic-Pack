extra card style:
	pt box:
		left:				577
		top:				926
		width:				137
		height:				75
		z index:			800
		visible:			{ card.pt != "" and not loyalty_has_abilities_1() }
		render style:		image
		image:
			script:
				if is_vehicle() then template("v", type: "pt") else (
				pure := pure_colors()
				count := length(pure)
				color := pt_colors()
				if styling.PT_color_scheme == "gold" and count > 1 then template("m", type: "pt")
				else if color == "land" and count > 1 then template("c", type: "pt")
				else if color == "hybrid" and count == 2 then masked_blend(mask: "special_blend_pt.png", dark: template(pure.0, type: "pt"), light: template(pure.1, type: "pt"))
				else if color == "colored" then (style := extra_card_style.pt_box; card_ptbox_crop(offset_x: style.left, offset_y: style.top, width: style.width, height: style.height, face_width: stylesheet.card_width, face_height: stylesheet.card_height))
				else card_ptbox())
	alias box:
		left:				0
		top:				0
		width:				{ stylesheet.card_width }
		height:				{ stylesheet.card_height }
		z index:			260
		visible:			{ card.alias != "" }
		render style:		image
		image:				{ module_alias() }
	vehicle overlay:
		left:				0
		top:				0
		width:				{ stylesheet.card_width }
		height:				{ stylesheet.card_height }
		z index:			240
		visible:			{ is_vehicle() }
		render style:		image
		image:				{ if is_crowned() then "crown/vcard.png" else "card/vcard.png" }
	stamp rim:
		left:				0
		top:				0
		width:				{ stylesheet.card_width }
		height:				{ stylesheet.card_height }
		z index:			740
		visible:			{ is_stamped() }
		render style:		image
		image:				{ card_stamp() }
	stamp border:
		left:				0
		top:				0
		width:				{ stylesheet.card_width }
		height:				{ stylesheet.card_height }
		z index:			730
		visible:			{ is_stamped() }
		mask:				border_stamp_mask.png
	foil layer:
		left:				0
		top:				0
		width:				{ stylesheet.card_width }
		height:				{ stylesheet.card_height }
		z index:			1050
		visible:			{ styling.overlay != "none" and styling.overlay != "" }
		render style:		image
		image:				{ if styling.overlay == "" then "" else styling.overlay + "/overlay.png" }

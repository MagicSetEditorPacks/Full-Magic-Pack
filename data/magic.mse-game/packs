#### Any Non-Token Card
pack type:
	name: random card
	selectable: true
	filter: not is_token_card()

#### Standard basic land
pack type:
	name: basic land
	select: equal
	filter: card.rarity == "basic land" and is_standard_pack_card(block_basic:false)

#### Showcase handlers
#### these are {rarity} without showcase, for cards without a linked showcase
#### {rarity} with showcase, for cards with a linked showcase
#### {rarity} showcase, for the linked showcase
#### then the {rarity} slot weights them so unique cards will show up at the same rate
#### and 20% of the time a has_showcase will be a showcase

pack type:
	name: any without showcase
	summary: false
	filter: is_standard_pack_card(block_shift:false) and not has_showcase()

pack type:
	name: any with showcase
	summary: false
	filter: is_standard_pack_card(block_shift:false) and has_showcase()

pack type:
	name: any showcase
	summary: false
	filter: is_showcase()


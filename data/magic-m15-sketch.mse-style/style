############################################################## Extra scripts
init script:
	dpi_factor := { stylesheet.card_dpi / 600.0 }
	
	swap_fonts_pt_default :=
	[
		name: {"Beleren Bold"},
		size: {64.0*dpi_factor()},
		color: {if is_vehicle() then "white" else "black"},
		vertical: {0},
		italic: {""}
	]
	
	swap_fonts_body_default :=
	[
		name: {"MPlantin"},
		size: {54.0*dpi_factor()},
		color: {"black"},
		vertical: {0},
		italic: {"MPlantin-Italic"}
	]
	swap_fonts_body2_default :=
	[
		name: {"MPlantin"},
		size: {54.0*dpi_factor()},
		color: {"black"},
		vertical: {0},
		italic: {"MPlantin-Italic"}
	]
	
	typeline_offset_top_1 := { 0 }
	typeline_offset_left_1 := { 0 }
	typeline_offset_width_1 := { 0 }
	typeline_character_limit := 34
	type_offset_right_1 := { if use_sketch_rarity() then -12*dpi_factor() else 0 }
	rarity_offset_top_1 := { 0 }
	indicator_offset_top_1 := { -4*dpi_factor() }
	swap_fonts_type_default :=
	[
		name: {"Beleren Bold"},
		size: {(52.0 - max(0, (length(to_text(card.type)) - typeline_character_limit) / 2))*dpi_factor()},
		color: {"black"},
		vertical: {0},
		italic: {""}
	]
	swap_fonts_type2_default :=
	[
		name: {"Beleren Bold"},
		size: {(40.0 - max(0, (length(to_text(card.type_2)) - typeline_character_limit) / 2))*dpi_factor()},
		color: {"black"},
		vertical: {0},
		italic: {""}
	]
	
	nameline_offset_top_1 := { -10*dpi_factor() }
	nameline_offset_left_1 := { 0 }
	nameline_offset_width_1 := { 0 }
	
	transform_symbol_image_folder := { "/" + stylesheet.folder_name + ".mse-style/transform/" }
	transform_symbol_multicolor_blend := { "white" }
	transform_symbol_modal_uses_normal_background := { true }
	transform_symbol_default_background := { "colored" }
	transform_symbol_default_rim := { "none" }
	transform_symbol_default_icon := { "colored" }
	transform_symbol_offset_left_1 := { 12*dpi_factor() }
	transform_symbol_offset_top_1 := { 0 }
	transform_symbol_offset_width_1 := { 0 }
	transform_symbol_offset_height_1 := { 0 }
	transform_symbol_icon_offset_width := { 0 }
	transform_symbol_icon_offset_height := { 0 }
	transform_symbol_icon_offset_width :=  { dpi_factor() * (if contains(card.transformation, match: "triangle") then 32 else 12) }
	transform_symbol_icon_offset_height := { dpi_factor() * (if contains(card.transformation, match: "triangle") then 32 else 12) }
	
	name_transform_symbol_offset_left_1 := { 36*dpi_factor() }
	casting_cost_transform_symbol_offset_left_1 := { -46*dpi_factor() }
	
	reminder_image_folder := { "/" + stylesheet.folder_name + ".mse-style/reminder/" }
	reminder_uses_light_variant := { true }
	reminder_offset_left := { -2*dpi_factor() }
	reminder_offset_top := { 0 }
	reminder_offset_width := { -10*dpi_factor() }
	reminder_offset_height := { -2*dpi_factor() }
	reminder_type_offset_left := { 15*dpi_factor() }
	reminder_cost_offset_left := { -15*dpi_factor() }
	
	alias_offset_left_1 := { 0 }
	alias_offset_top_1 := { -4*dpi_factor() }
	alias_offset_width_1 := { -160*dpi_factor() }
	
	casting_cost_offset_top_1 := { -2*dpi_factor() }
	swap_fonts_name_default :=
	[
		name: {"Beleren Bold"},
		size: {56.0*dpi_factor()},
		color: {"black"},
		vertical: {0},
		italic: {""}
	]
	swap_fonts_name2_default :=
	[
		name: {"Beleren Bold"},
		size: {48.0*dpi_factor()},
		color: {"black"},
		vertical: {0},
		italic: {""}
	]
	
	card_stamp_offset_top_1 := { dpi_factor() * (if stamp_shape() == "triangle" then 12 else 4) }
	
	template_prefix :=
	[
		card:		"card/",
		alias:		"alias/",
		pt:			"pt/",
		stamp:		"stamp/",
		crown:		"crown/",
		identity:	"/magic-modules.mse-include/indicators/",
		single_page: "page/single/",
		double_page: "page/double/"
	]
	template_suffix :=
	[
		card:		"card.png",
		alias:		".png",
		pt:			"pt.png",
		crown:		"crown.png",
		stamp:		"stamp.png",
		identity:	"identity.png",
		single_page: ".png",
		double_page: ".png"
	]
	template :=
	{
		if is_vehicle() then input := if type == "card" or type == "pt" or type == "stamp" then "v" else "c"
		template_prefix[type] + input + template_suffix[type]
	}
	colored_lands := false
	
	card_border :=		{ color_background(input: card.card_color, type: "border",		base_hybrid: card_hybrid,	multicolor_blend: "white",	hybrid_blend: "white",	artifact_blend: "white") }
	card_background :=	{ color_background(input: card.card_color, type: "card",		base_hybrid: card_hybrid,	multicolor_blend: "mask",	hybrid_blend: "mask",	artifact_blend: "mask") }
	card_ptbox :=		{ color_background(input: card.card_color, type: "pt",			base_hybrid: card_hybrid,	multicolor_blend: "white",	hybrid_blend: "white",	artifact_blend: "white") }
	card_crown :=		{ color_background(input: card.card_color, type: "crown",		base_hybrid: card_hybrid,	multicolor_blend: "white",	hybrid_blend: "white",	artifact_blend: "white") }
	module_alias :=		{ color_background(input: card.card_color, type: "alias",		base_hybrid: card_hybrid,	multicolor_blend: "white",	hybrid_blend: "white",	artifact_blend: "white") }
	card_stamp :=		{ color_background(input: card.card_color, type: "stamp",		base_hybrid: card_hybrid,	multicolor_blend: "white",	hybrid_blend: "white",	artifact_blend: "white") }
	card_single_page := { color_background(input: card.card_color_2, type:"single_page",base_hybrid: card_hybrid,	multicolor_blend: "white",	hybrid_blend: "white",	artifact_blend: "white") }
	card_double_page := { color_background(input: card.card_color_2, type:"double_page",base_hybrid: card_hybrid,	multicolor_blend: "white",	hybrid_blend: "white",	artifact_blend: "white") }
	pure_colors :=
	{
		sort_text(
			order: if card_is_wedge(input) then "(wbgur)" else "(wubrg)",
			(if chosen(card.card_color, choice:"white")	then "w") +
			(if chosen(card.card_color, choice:"blue")	then "u") +
			(if chosen(card.card_color, choice:"black")	then "b") +
			(if chosen(card.card_color, choice:"red")	then "r") +
			(if chosen(card.card_color, choice:"green")	then "g")
		)
	}
	pt_colors := { if styling.PT_color_scheme == "canon" then pt_colors_canon() else styling.PT_color_scheme }
	pt_colors_canon := { if contains(card.card_color, match: "hybrid") then "land" else "gold" }
	
	foil_mask_added_sections := { [] }
	foil_mask_removed_sections := { [] }
	
	chop_top :=			{ split := split_comma(styling.chop_text_box); if length(split) > 0 and split[0] != "" and split[0] != "-" then clamp(split[0], maximum:500, minimum:-500) else 0 }
	chop_bottom :=		{ split := split_comma(styling.chop_text_box); if length(split) > 1 and split[1] != "" and split[1] != "-" then clamp(split[1], maximum:500, minimum:-500) else 0 }
	chop_right :=		{ split := split_comma(styling.chop_text_box); if length(split) > 2 and split[2] != "" and split[2] != "-" then clamp(split[2], maximum:500, minimum:-500) else 0 }
	
	popout_left :=		{ split := split_comma(styling.popout_art_coordinates); if length(split) > 3 and split.0 != "" then clamp(split.0, maximum: 1500, minimum: -500) else 0 }
	popout_top :=		{ split := split_comma(styling.popout_art_coordinates); if length(split) > 3 and split.1 != "" then clamp(split.1, maximum: 2000, minimum: -500) else 0 }
	popout_width :=		{ split := split_comma(styling.popout_art_coordinates); if length(split) > 3 and split.2 != "" then clamp(split.2, maximum: 1500, minimum: 0) else 0 }
	popout_height :=	{ split := split_comma(styling.popout_art_coordinates); if length(split) > 3 and split.3 != "" then clamp(split.3, maximum: 2000, minimum: 0) else 0 }
	
	art_left :=			{ if styling.stretch_art_to_whole_card then 0						else 113  * dpi_factor() }
	art_top :=			{ if styling.stretch_art_to_whole_card then 0						else 227  * dpi_factor() }
	art_width :=		{ if styling.stretch_art_to_whole_card then stylesheet.card_width	else 1274 * dpi_factor() }
	art_height :=		{ if styling.stretch_art_to_whole_card then stylesheet.card_height	else 933  * dpi_factor() }
	art_mask :=
	{
		
		crop(
			resize_image(
				"image_mask.png",
				width: stylesheet.card_width,
				height: stylesheet.card_height
			),
			offset_x: art_left(),
			offset_y: art_top(),
			width: art_width(),
			height: art_height()
		)
	}
	
	# Should hybrids have a grey name?
	mask_hybrid_with_land := { styling.grey_hybrid_name }
	
	# Should multicolor lands with basic land types have a colored name?
	mask_multi_land_with_color := { styling.colored_multicolor_land_name }
	
	# Is the card a promo card?
	is_promo := { styling.promo }
	
	# Is the card automatically numbered
	is_unsorted := { styling.remove_from_autocount }
	
	# Use the special rarity render
	use_sketch_rarity := { styling.sketch_rarity }
	sketch_rarity_symbol :=
	{
		symbol_variation(
			symbol:set.symbol,
			border_radius: 0.15,
			fill_type: "linear gradient",
			fill_color_1: rgba(0,0,0,0),
			fill_color_2: rgba(0,0,0,0),
			border_color_1: if card.rarity == "common" or card.rarity == "basic land" then rgb(255,255,255) else rgb(0,0,0),
			border_color_2: if card.rarity == "common" or card.rarity == "basic land" then rgb(255,255,255) else rgb(0,0,0),
			center_x:0.5,
			center_y:0.5,
			end_x:1,
			end_y:1
		)
	}
	
	# Use the legend crown
	is_crowned := { styling.legend_crown == "yes" or (styling.legend_crown == "if legendary" and lang_setting("is_legendary")(card.super_type)) }
	
	# Use the vehicle frame
	is_vehicle := { styling.vehicle_frame == "yes" or (styling.vehicle_frame == "if vehicle" and lang_setting("is_vehicle")(card.sub_type)) }

	# Adventure shape
	card_shape := { if is_adventure() then "adventure" else "normal" }
	is_adventure := { not chosen(extra_card.adventure_style, choice:"none") }
	adv_left := {chosen(extra_card.adventure_style, choice:"left") }
	adv_right := {chosen(extra_card.adventure_style, choice:"right") }
	adv_double := {chosen(extra_card.adventure_style, choice:"name and type") }
	adv_style_filter := {
		input := require_exclusive_choice(input, choices: "none, left, right")
		input := require_exclusive_choice(input, choices: "name and type,name only")
		input
	}

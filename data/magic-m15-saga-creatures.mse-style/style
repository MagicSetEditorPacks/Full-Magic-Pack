card style:
	############################# Background stuff
	card color:
		left:				0
		top:				0
		width:				{ stylesheet.card_width }
		height:				{ stylesheet.card_height }
		z index:			200
		render style:		image
		popup style:		in place
		image:				{ card_background() }
		mask:				card_mask.png
	############################# Image
	image:
		left:				{ if styling.stretch_image_to_whole_card then 0							else 373 }
		top:				{ if styling.stretch_image_to_whole_card then 0							else 217 }
		width:				{ if styling.stretch_image_to_whole_card then stylesheet.card_width		else 313 }
		height:				{ if styling.stretch_image_to_whole_card then stylesheet.card_height	else 566 }
		z index:			100
	mainframe image:
		left:				{ popout_left() }
		top:				{ popout_top() }
		width:				{ popout_width() }
		height:				{ popout_height() }
		z index:			1000
	############################# Text box
	text 2:
		left:				61
		top:				{ 863 + chop_top() + (if is_stamped() then 3 else 0) + body_font_vertical() }
		right:				{ 683 - chop_right() }
		bottom:				{ 952 - chop_bottom() - if is_stamped() then 5 else 0 }
		z index:			900
		line height hard:	{ if is_modal(card.rule_text_2) then 0.9 else 1.2 }
		line height line:	1.5
		line height soft:	0.9
		line height hard max:	{ if is_modal(card.rule_text_2) then 1.0 else 1.3 }
		line height line max:	1.6
		alignment:
			script:
				if (styling.center_bottom_text == "short text only" and
				   not contains(match:"\n", card.rule_text_2) and
				   card.flavor_text_2 == "<i-flavor></i-flavor>" and
				   card_style.text_2.content_lines <= 2) or
				   styling.center_bottom_text == "always"
				then "middle center"
				else "middle left"
		font:
			name:				{ body_font() }
			italic name:		{ body_font_italic() }
			size:				{ body_font_size() }
			scale down to:		7
			color:				{ body_font_color() }
		symbol font:
			name:				{ styling.text_box_mana_symbols }
			size:				{ body_font_size() }
			scale down to:		7
	############################# PT
	pt:
		left:				593
		top:				933
		width:				94
		height:				43
		z index:			900
		alignment:			center middle shrink-overflow
		font:
			name:				{ pt_font() }
			italic name:		{ pt_font_italic() }
			size:				{ pt_font_size() }
			color:				{ pt_font_color() }
			separator color:	red


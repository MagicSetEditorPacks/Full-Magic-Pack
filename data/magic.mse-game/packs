### Shifted
### collated slots

pack type:
	name: uncommon legend
	filter: card.rarity == "uncommon" and is_standard_pack_card() and lang_setting("is_legendary")(card.type)

pack type:
	name: rare legend
	filter: (card.rarity == "rare" or card.rarity == "mythic rare") and is_standard_pack_card() and lang_setting("is_legendary")(card.type)

pack type:
	name: uncommon planeswalker
	filter: card.rarity == "uncommon" and is_standard_pack_card() and lang_setting("is_planeswalker")(card.type)

pack type:
	name: note 1
	filter: set.slotting_note_1 != "" and contains(card.notes, match:set.slotting_note_1)

pack type:
	name: note 2
	filter: set.slotting_note_2 != "" and contains(card.notes, match:set.slotting_note_1)

pack type:
	name: note !nbslot
	filter: contains(card.notes, match:"!nbslot")


	pt box:
		left: 303
		top: 128
		width: 50
		height:	34
		z index: 1
		visible: { card.pt != "" }
		render style: image
		image:
			script:
				image := module_ptbox()
				if is_back() then image := color_multiply(width:135, height:76, multiply_mask:template_prefix["pt"] + "multiply_mask.png")
				image
	pt box 2:
		right: 20
		bottom: 346
		width: 50
		height:	34
		angle: 180
		z index: 1
		visible: { card.pt_2 != "" }
		render style: image
		image:
			script:
				image := module_ptbox()
				if is_back() then image := color_multiply(width:135, height:76, multiply_mask:template_prefix["pt"] + "multiply_mask.png")
				image
	foil layer:
		left: 0
		top : 0
		width: 375
		height: 523
		z index: 1050
		render style: image

update cards script:
	before version: 2026-08-15
	description: Updates styling fields
	script:
		room :=				chosen(styling.frames,			choice:"room") or lang_setting("is_room")(card.sub_type)
		short_room :=		chosen(styling.other_options,	choice:"short room image")
		borderless :=		chosen(styling.frames,			choice:"borderless")
		colorless :=		chosen(styling.frames,			choice:"clear colorless")
		spillover :=		chosen(styling.other_options,	choice: "spillover image")
		left_clear :=		colorless and card.card_color == "colorless" and (not room or card.card_color_2 == "colorless")
		right_clear :=		colorless and card.card_color_2 == "colorless" and (not room or card.card_color == "colorless")
		one_image :=		if room then styling.room_images == "one image" else spillover and not borderless and not left_clear and not right_clear
		
		[new_card(
			copy_from: card,
			[
				uid:						if card.uid == "" then new_uid() else card.uid,
				rule_text_3:				if room then "" else nil,
				rule_text_4:				if room then card.rule_text_3 else nil,
				styling_data:
				[
					auto_frames:				if styling.use_fuse_arrows then require_choice(styling.auto_frames, choices: "arrows") else remove_choice(styling.auto_frames, choices: "arrows")
					other_options:				remove_choice(styling.other_options, choice1:"spillover image", choice2: "short room image")
					image_layout:				if one_image then "one image" else if styling.room_images == "three images" then "three images" else "two images"
					typebox_solid_color:		if styling.room_backfill == rgb(0,0,0) then rgba(0,0,0,0) else styling.room_backfill,
					typebox_opacity_percentage:	if short_room then "100" else nil,
					rarity_offsets:				"",
				]
			]
		)]


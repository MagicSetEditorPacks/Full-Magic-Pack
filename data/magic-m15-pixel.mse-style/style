############################################################## Extra scripts
init script:
	# Load scripts for image box
	include file: /magic-default-image.mse-include/scripts
	
	# Should hybrids have a grey name?
	mask_hybrid_with_land := { styling.grey_hybrid_name }
	
	#Should multicolor lands with basic land types have a colored name?
	mask_multi_land_with_color := { styling.colored_multicolor_land_name }
	
	template_prefix := [
		card: "card/"
		pt: "pt/",
		crown: "crown/",
		stamp: "/magic-modules.mse-include/stamps/backs/375 round/"
		ubstamp: "/magic-modules.mse-include/stamps/backs/375 ub/"
		identity: "/magic-modules.mse-include/indicators/"
	]
	template_suffix := [
		card: "card.png"
		pt: "pt.png"
		crown: "crown.png"
		stamp: "stamp.png"
		ubstamp: "stamp.png"
		identity: "identity.png"
	]
	template      := { template_prefix[type] + input + template_suffix[type] }
	land_template := { template_prefix[type] + "l" + template_suffix[type] }
	# Use land templates for previews because they show more contrast
	hybrid_previews := "land,hybrid"
	watermark_include := "/magic-modules.mse-include/watermarks"
	# Use the normal tap symbol
	mana_t := {
		if      styling.tap_symbol == "old"        then "old"
		else if styling.tap_symbol == "diagonal T" then "older"
		else                                            "new"
	}
	
	# Use guild mana symbols?
	guild_mana := { styling.use_guild_mana_symbols }
	
	# Is the card a promo card?
	is_promo := { styling.promo }
	ancestral_mana := { styling.ancestral_mana_symbols }
	is_unsorted := {styling.remove_from_autocount}
	
	blended_img := {
		colors := get_colors(card.card_color)
		len := length(colors)
		if len > 1 then masked_blend(dark:fn(colors[0]), light:fn(colors[1]), mask:fn("split"))
		else fn(colors[0])
	}
	fn := {
		type + "/" + input + type + ".png"
	}
	blended_card := {
		cover := if lang_setting("is_enchantment")(card.type) then "nyx"
			else if lang_setting("is_land")(card.type) then "land"
			else if lang_setting("is_artifact")(card.type) then "artifact"
			else "none"
			
		base := if cover == "nyx" then blended_img(type:"nyx") else blended_img(type:"card")
		if cover == "land" then
			base := masked_blend(
				dark: "card/lcard.png",
				light: base,
				mask: "card/artifact_blend_card.png"
			)
		if cover == "artifact" then
			base := masked_blend(
				dark: "card/acard.png",
				light: base,
				mask: "card/artifact_blend_card.png"
			)
		base
	}
	blended_crown := {
		blended_img(type:"crown")
	}
	get_colors := {
		land		:= chosen(choice:"land")
		multi		:= chosen(choice:"multicolor")
		hybrid		:= chosen(choice:"hybrid")
		artifact	:= chosen(choice:"artifact")
		if land and colored_lands then template := land_template # use land template instead?
		
		# The selected colors
		colors := blend_colors(input,land:land, multi:multi, hybrid:hybrid, artifact:artifact)
		len := length(colors)
		if land then ["l"]
		else if len > 2 then ["m"]
		else if len == 0 then ["c"]
		else colors
	}
	right_color := {
		colors := get_colors()
		if length(colors) > 1 then colors[1] else colors[0]
	}
	rarity_trios := [
		w: [[252,252,162], [126,127,0]],
		u: [[0,0,252], [0,0,127]],
		b: [[170,0,230], [85,0,114]],
		r: [[255,0,0], [111,0,0]],
		g: [[0,255,0], [0,127,0]],
		m: [[248,216,59], [163,75,43]],
		l: [[248,216,59], [163,75,43]],
		c: [[154,154,154], [79,79,79]],
		a: [[154,154,154], [79,79,79]]
	]
	rarity_colors := {
		trio := rarity_trios[color][index]
		rgb(trio.0, trio.1, trio.2)
	}
	rarity_light_color := {
		rarity_colors(color:right_color(card.card_color), index:0)
	}
	rarity_dark_color := {
		rarity_colors(color:right_color(card.card_color), index:1)
	}
	rarity_strings := {
		trio := rarity_trios[color][index]
		"rgb({trio.0},{trio.1},{trio.2})"
	}
	rarity_light_string := {
		rarity_strings(color:right_color(card.card_color), index:0)
	}
	rarity_dark_string := {
		rarity_strings(color:right_color(card.card_color), index:1)
	}
	color_1 := replace@(match:"(1|2)", replace:{"<color:" + (if _1 == "2" then rarity_light_string() else rarity_dark_string()) + ">" + _1 + "</color>"})
	colorize := remove_tag@(tag:"<color") + color_1
	
	rarity_symbol := {
		if styling.rarity_symbol == "regular" then "" else styling.rarity_symbol
	}
	use_alt_rarity := { extra_card.generator != "" or rarity_symbol() != "" }
	alt_symbol := {""}
	sym_builder := {
		blocker := replace(input, match:";", replace:"\n")
		lines := string_breaker(blocker)
		base := "rarity/canvas.png"
		light_sq := recolor_image(input:"rarity/red.png", color:rarity_light_color())
		dark_sq := recolor_image(input:"rarity/red.png", color:rarity_dark_color())
		y_max := min(7, length(lines)-1)
		for y from 0 to y_max do (
			x_max := min(17, length(lines[y])-1)
			for x from 0 to x_max do (
				index := x_max - x
				val := lines[y][index]
				if val == "1" or val == "2" then (
					adj_x := 54 - (3*x)
					adj_y := (3*y)
					base := insert_image(
						base_image: base,
						inserted_image:(if val == "2" then light_sq else dark_sq),
						offset_x:adj_x,
						offset_y:adj_y
					)
				)
				""
			)
		)
		base
	}
	string_breaker := {
		fixed := ""
		counter := 0
		for x from 0 to length(input)-1 do (
			char := input[x]
			if counter == 17 or char == "," or char == "\n" or char == ";" then (
				counter := 0
				fixed := fixed + "," + (if counter == 17 then char else "")
			) else (
				fixed := fixed + char
				counter := counter + 1
			)
		)
		split_comma(fixed)
	}
	shrink_name := { to_number_lax(styling.shrink_name) }
	shrink_type := { to_number_lax(styling.shrink_type) }
	rarity_offset_top_1 := {-1}
	err_rarity_string := {
		 "0000020000\n"
		+"0000212000\n"
		+"0020222000\n"
		+"0212212020\n"
		+"0021212212\n"
		+"0002112120\n"
		+"0000211200\n"
		+"0000212000"
	}
	
	special_text := {
		replace(card.rule_text, match:"^> ", replace:"")
	}

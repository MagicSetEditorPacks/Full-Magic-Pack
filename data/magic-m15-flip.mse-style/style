mse version:		2.6.0
game:				magic
short name:			M15 Flip
icon:				card-sample.png
position hint:		000040
installer group:	magic/M15 Frames/Standard/M15 Flip


version: 2024-06-06
depends on:
	package: magic.mse-game
	version: 2026-08-28
depends on:
	package: magic-default-image.mse-include
	version: 2007-09-23
depends on:
	package: magic-modules.mse-include
	version: 2026-08-28
depends on:
	package: magic-mana-large.mse-symbol-font
	version: 2007-09-23

card style:
	############################# Background stuff
	card color:
		left:	0
		top:	0
		width:	375
		height:	523
		z index: 0
		render style: image
		popup style: in place
		image: { blended_card() }
	############################# Name line
	name:
		left: { if card.card_symbol == "none" then 32 else 50 }
		top: {31-round_up(shrink_name()/2)}
		right:  { 341 - card_style.casting_cost.content_width }
		height: 23
		alignment: bottom shrink-overflow
		padding bottom: 0
		z index: 1
		font:
			name: Space Mono
			size: {16-shrink_name()}
			color: white
	casting cost:
		right: 348
		top: 24
		width: { max(30, card_style.casting_cost.content_width) + 5 }
		height: 30
		alignment: middle right
		font:
			name: MPlantin
			size: 15
		symbol font:
			name: magic-mana-pixel
			size: 15
			alignment: middle right
		always symbol: true
		z index: 2
		padding top: 0
	############################# Image
	image:
		left: 30
		top: 60
		width: 315
		height:	228
		z index: 1
		default: {default_image(card.card_color)}
	############################# Card type
	indicator:
		left: 31
		top: 297
		width: 17
		height: 17
		z index: 1
		render style: image
		visible: { has_identity() }
		image: { module_identity() }
	type:
		left: { if has_identity() then "52" else "32" }
		top: 295
		width: { (if has_identity() then "290" else "310") - 26 }
		height: 20
		alignment: middle shrink-overflow
		z index: 1
		padding top: 2
		font:
			name: Space Mono
			size: { 13 - shrink_type() }
			color: white
			separator color: red
	############################# Text box
	text:
		left: 30
		top: { 330 + module_chop(0) }
		width: 310
		bottom: { 475 - module_chop(1) }
		font:
			name: Space Mono
			size: 15
			scale down to: 6
			color: white
		symbol font:
			name: { styling.text_box_mana_symbols }
			size: 15
		alignment:
			script:
				if (styling.center_text == "short text only" and
				   not contains(match:"\n", card.rule_text) and
				   card.flavor_text == "<i-flavor></i-flavor>" and
				   card_style.text.content_lines <= 2) or
				   styling.center_text == "always"
				then "middle center"
				else "middle left"
		z index: 2
		padding left:   6
		padding right:  4
		line height hard: 0.75
		line height line: 0.75
		line height soft: 0.75
		line height hard max: 1.0
		line height line max: 1.0
	watermark:
		left: 117
		top: 321
		width: 138
		height: 166
		z index: 1
		render style: image
		popup style: in place
		alignment: middle center
		include file:	/magic.mse-game/watermarks/menu_choice_images
		image:			{ watermark_image_1() }
	############################# PT
	pt:
		z index: 720
		left: 286
		top: 469
		width: 66
		height:	24
		alignment: center middle shrink-overflow
		font:
			name: Space Mono
			size: 18
			color: white
			separator color: red

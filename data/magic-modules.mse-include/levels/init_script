## the script that templates will use
## input: card_color, image: image to multiply
## returns image with the level multiplication applied
## supports DFC module notch and extra backface muliplication
leveler_multiply := {
	## put these here to make sure leveler_multiply_mask uses the same ones
	width := stylesheet.card_width
	height := stylesheet.card_height
	start := 1
	end := last_active_level()-1
	bump := 0
	if is_back_face() then (
		start := 0
		bump := 1
	)
	iterate := round_up(multi_scale[end+bump] or else 0)

	## skip if we haven't loaded text layout yet
	if not leveler_enabled() then image
	else if card_style.text.layout.separators[0] or else -1 < 0 then image
	else color_multiply(
		input,
		image: image,
		multiply_mask: leveler_multiply_mask(),
		iterate: iterate
	)
}

######## Fonts
## fonts for level label
leveler_label_font 		:= { "Beleren Small Caps" }
leveler_label_font_size := { leveler_coord_factor() * 7.5 }
## font size for the level number
leveler_container_font_sizes := [
	"circle":	10,
	"station":	10,
	"loyalty":	11,
	"fallback":	12
]
leveler_label_font_size_big := { 
	shape := leveler_container_shape()
	base := leveler_container_font_sizes[shape] or else leveler_container_font_sizes["fallback"]
	if leveler_blanked_label(level:1) then base := base + leveler_blanked_label_font_offset()
	leveler_coord_factor() * base
}@(mana:false)
leveler_blanked_label_font_offset := {
	if (shape == "arrow" and not mana) 	then 2
	else if shape == "box"				then 2
	else									 0
}
## font color for both
leveler_label_font_color := {
	shape := leveler_container_shape()
	if shape == "loyalty" or shape == "circle" or shape == "station"
		then "white"
	else if is_back_face()
		then "white"
	else if leveler_vehicle_containers()
		then "white"
	else "black"
}
## font stroke for both

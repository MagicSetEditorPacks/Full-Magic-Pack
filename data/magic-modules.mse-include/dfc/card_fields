extra card field:
	type: text
	name: back face hint
	script: back_face_hint()
	editable: false
	save value: false
extra card field:
	type: choice
	name: meld bar
	choice: bar
	editable: false
	save value: false
extra card field:
	type: choice
	name: node
	script: card.card_color
	editable: false
	save value: false

extra card style:
	back face hint:
		z index: 	650
		right: 		{ 347 * face_coordinates_map(1).width/375 + back_face_hint_offset_left() }
		top: 		{ 446 * face_coordinates_map(1).height/523 + back_face_hint_offset_top() }
		width: 		{ 30 * face_coordinates_map(1).width/375 + back_face_hint_offset_width() }
		height: 	{ 12 * face_coordinates_map(1).height/523 + back_face_hint_offset_height() }
		alignment: 	bottom right
		visible: 	{ is_notched() }
		font:
			name: 	ModMatrix
			size: 	{ 12 * face_coordinates_map(1).width/375 }
			weight: bold
			color: 	{ back_face_hint_color() }
			stroke color:  { back_face_hint_stroke_color() }
			stroke radius: { back_face_stroke_radius() }
			separator color: red
			
	node:
		left: 		0
		top: 		0
		width: 		{ stylesheet.card_width }
		height: 	{ stylesheet.card_height }
		render style: image
		z index: 	310
		image: 		{ module_node() }
		visible:	{ not transform_symbol_is_empty(card.transformation) }

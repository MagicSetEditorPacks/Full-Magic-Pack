#### Showcase-compatible base rarity slots
#### sub-slots are defined at the bottom
#### because they're pretty useless from the user's end without weights
#### For some reason making the weights 100x makes the distribution better
#### no i don't understand why
pack type:
	name: common
	filter: card.rarity == "common" and is_standard_pack_card(block_showcase:false)
	select: proportional
	item:
		name: common without showcase
		weight: 500
	item:
		name: common with showcase
		weight: 400
	item:
		name: common showcase
		weight: 100

pack type:
	name: uncommon
	filter: card.rarity == "uncommon" and is_standard_pack_card(block_showcase:false)
	select: proportional
	item:
		name: uncommon without showcase
		weight: 500
	item:
		name: uncommon with showcase
		weight: 400
	item:
		name: uncommon showcase
		weight: 100

pack type:
	name: mythic rare or rare
	filter: (card.rarity == "rare" or card.rarity == "mythic rare")  and is_standard_pack_card(block_showcase:false)
	select: equal proportional
	item:
		name: mythic rare
		weight: 1
	item:
		name: rare
		weight: 2


	name: pt box
	choice: box
	editable: false
	save value: false
extra card field:
	type: choice
	name: crown
	choice: box
	editable: false
	save value: false
extra card field:
	type: color
	name: rarity light
	script: rarity_light_color()
	editable: false
	save value: false
extra card field:
	type: color
	name: rarity dark
	script: rarity_dark_color()
	editable: false
	save value: false
extra card field:
	type: choice
	name: rarity gen
	choice: gen
	editable: false
	save value: false
extra card field:
	type: text
	name: generator

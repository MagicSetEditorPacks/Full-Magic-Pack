init script:
	# Should hybrids have a grey name?
	mask_hybrid_with_land := { styling.grey_hybrid_typeline }

	# Load scripts for image box
	include file: /magic-default-image.mse-include/scripts
	
	template_prefix := [
		card: "cards/"
		namebar: "cards/namebar/"
		notch: "cards/notch/"
		texture: "cards/texture/"
		snow: "/magic-modules.mse-include/trims/snow/"
		nyx: "/magic-modules.mse-include/trims/nyx/"
		pt:"/magic-modules.mse-include/pts/375 m15/"
		stamp:"stamps/round/"
		ubstamp:"stamps/ub/"
		star: "/magic-modules.mse-include/trims/star/",
	]
	template_suffix := [
		card: "card.png",
		namebar: "card.png",
		notch: "card.png",
		texture: "card.png",
		snow: "snow.png"
		nyx: "nyx.png"
		pt: "pt.png"
		stamp: "stamp.png"
		ubstamp: "stamp.png",
		snowbox: "card.jpg"
		star: "star.png",
	]
	template      := {
		if type_name(template_alternate_scripts[type] or else nil) != type_name(nil)
			then template_alternate_scripts[type](input, land:false)
		else template_prefix[type] 
			+ (if is_beyond() and uses_ub(type) then "beyond/" else "")
			+ input
			+ template_suffix[type]
	}
	land_template := template
	uses_ub := { ub_array[input] or else false }
	ub_array := [
		"card": true,
		"notch": true,
		"texture": true,
		"namebar": true
	]
	points_template := {
		color := alias_colors(input, land:false)
		recolor_image("modal_points.png")
	}
	template_alternate_scripts := [
		points: points_template
	]

	# Use the normal tap symbol
	mana_t := {
		if      styling.tap_symbol == "old"        then "old"
		else if styling.tap_symbol == "diagonal T" then "older"
		else                                            "new"
	}
	
	# Use guild mana symbols?
	guild_mana := { styling.use_guild_mana_symbols }

	is_promo := { styling.promo }
	########## Frame styling
	card_shape := { "battle" }
	is_unsorted := {styling.remove_from_autocount}
	is_vehicle :=	{ (auto_vehicle()	or contains(styling.frames, match:"vehicle")) }
	is_nyx :=		{ (auto_nyx()		or contains(styling.frames, match:"nyx")) }
	is_snow :=		{ (auto_snow()		or contains(styling.frames, match:"snow")) }
	is_beyond := 	{ (auto_ub()		or contains(styling.frames, match:"universes beyond")) }
	auto_vehicle := { contains(styling.auto_frames, match:"vehicle")	and lang_setting("is_vehicle")(card.sub_type) }
	auto_nyx :=		{ contains(styling.auto_frames, match:"nyx")		and lang_setting("is_enchantment")(card.super_type) }
	auto_snow :=	{ contains(styling.auto_frames, match:"snow")		and lang_setting("is_snow")(card.super_type) }
	auto_ub :=		{ contains(styling.auto_frames, match:"universes beyond")		and (card.card_stamp == "universes beyond" or card.card_stamp == "flatstamped universes beyond") }

	is_custom_border := {
		if chosen(styling.frames, choice:"custom border")
			then has_png(styling.custom_border_source)
		else auto_custom_border()
	}
	custom_border_blend := { color_background(type:"custom_border",     base_hybrid:card_hybrid) }
	namebar_background := { color_background(type:"namebar",     base_hybrid:card_hybrid, folder:template_prefix["namebar"], blend_type:"card", artifact_blend:"white") }
	notch_background := { 
		image := color_background(type:"notch",     base_hybrid:card_hybrid, artifact_blend:"white", multicolor_blend:"white", hybrid_blend:"white")
		if is_back_face() then
			image := color_multiply(width:523, height:375, multiply_mask:"notch_multiply.png", iterate:0.35)
		image
	}
	texture_background := { color_background(type:"texture",     base_hybrid:card_hybrid, folder:template_prefix["texture"], blend_type:"card") }
	stamp_img := {
		sh := stamp_shape()
		"/magic-modules.mse-include/stamps/backs/" + (if sh == "triangle" then "triangle_stamp.png" else "stamp.png")
	}
	points_img := {color_background(type:"points", base_hybrid:card_hybrid, artifact_blend:"white", multicolor_blend:"white", hybrid_blend:"white") }
	
	is_borderless := { styling.image_style == "borderless" }
	is_boxed := { styling.image_style == "boxed" }
	is_spillover := { styling.image_style == "spillover" }
	fullest_art := { is_borderless() and not styling.maintain_black_copyright_area }
	
	transform_side := {
		if transform_symbol_active_left(card.transformation)
			then "left"
		else if transform_symbol_active_right(card.transformation)
			then "right"
		else ""
	}
	transform_symbol_offset_left_1 := {
		if transform_side() == "right" then 1 else 0
	}
	
	swap_fonts_name_default := [
		name: {"Beleren Bold"},
		size: {15},
		color: {if is_back_face() then "white" else "black"},
		vertical: {0},
		italic: {""}
	]
	swap_fonts_pt_default := [
		name: {"Beleren Bold"},
		size: {15},
		color: {if is_back_face() then "white" else if styling.defense_style == "pt" then "black" else "white"},
		vertical: {0},
		italic: {""}
	]
	swap_fonts_type_default := [
		name: {"Beleren Bold"},
		size: {13},
		color: {if is_back_face() then "white" else "black"},
		vertical: {0},
		italic: {""}
	]

	
	#### modal dfc flags
	reminder_disabled := { not is_linked_dfc() }
	ptbox_img := {
		image := module_ptbox(vehicle:is_vehicle())
		if is_back_face() then image := color_multiply(width:135, height: 76)
		image
	}
	
	reminder_offset_width := { -67 }
	reminder_offset_height := { 7 }
	
	back_face_hint := {
		back := get_back_face(card) or else nil
		if back == nil or styling.back_face_hint == "none" then ""
		else if styling.back_face_hint == "PT, Loyalty, Defense" and back.loyalty != ""
			then back.loyalty
		else back.pt
	}
	
	card_img := {
		image := module_card()
		if is_back_face() then (
			image := color_multiply(width:523, height:375, multiply_mask:"cards/hybrid_blend_card.png")
			image := color_multiply(width:523, height:375, multiply_mask:"textbox_multiply.png", iterate:0.35)
		)
		image
	}
	modified_snow := {
		image := module_snow()
		insert_image(
			base_image: image,
			inserted_image: image,
			offset_x: 0,
			offset_y: 100,
			widen: false
		)
	}
	
	## transparent frame
	perc_to_color := {
		if input == 100 then 255
		else if input == 0 then 0
		else to_int(2.55 * (input))
	}
	trans_mask := {
		if is_spillover() or is_boxed() or styling.textbox_opacity == 100 then input
		else (
			a := perc_to_color(styling.textbox_opacity)
			mask := recolor_image("mask_parts/{type}.png", color:rgb(a, a, a))
			set_mask(image:input)
		)
	}
	trans_mask_textbox := {
		if is_spillover() or is_boxed() or styling.textbox_opacity == 100 then input
		else (
			name_part := "transform_" + (if transform_symbol_is_empty(card.transformation) then "none" else if transform_symbol_active_left(card.transformation) then "left" else "right")
			text_part := "text" + if is_notched() then "_notched"
			trans_mask(
				trans_mask(
					type: name_part
				),
				type: text_part
			)
		)
	}
	
	#### DFC support
	include file: /magic-modules.mse-include/dfc/init_script
	default_notched := is_notched
	is_notched := {
		if styling.show_transform_notch == "no"
			then false
		else if styling.show_transform_notch == "yes"
			then true
		else default_notched()
	}
	node_disabled := { true }
	back_face_hint_offset_top := { 9 }
	back_face_hint_offset_left := { -10 }
	reminder_offset_left := { 33 }
	reminder_offset_top := { 4 }
	alias_offset_top_1 := {-8}
	alias_mask := { "/magic-modules.mse-include/alias/masks/remove_outline.png" }
	
	base_alias_colors := {
		[
			w: rgb(255, 255, 255),
			u: rgb(7, 114, 182),
			b: rgb(32, 38, 34),
			r: rgb(243, 68, 38),
			g: rgb(6, 120, 68),
			a: rgb(255, 255, 255),
			m: rgb(236, 208, 124),
			c: rgb(168, 154, 145)
		][input]
	}
	beyond_alias_colors := {
		[
			w: rgb(248, 249, 251),
			u: rgb(10, 116, 190),
			b: rgb(38, 36, 37),
			r: rgb(221, 62, 43),
			g: rgb(28, 109, 68),
			a: rgb(244, 245, 239),
			m: rgb(243, 215, 108),
			c: rgb(167, 153, 142)
		][input]
	}
	alias_colors := {
		if is_beyond() then beyond_alias_colors() else base_alias_colors()
	}
	has_modal := match@(match:"modal")	



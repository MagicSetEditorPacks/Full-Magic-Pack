extra card field:
	type: text
	name: back face hint
	script: back_face_hint()
	editable: false
	save value: false
extra card field:
	type: color
	name: meld bar
	choice: white
	editable: false
	save value: false
extra card field:
	type: choice
	name: node
	script: node_color()
	editable: false
	save value: false

extra card style:
	back face hint:
		z index: 	650
		right: 		{ stylesheet.card_width - (28 * face_factor(1)) + back_face_hint_offset_left() }
		top: 		{ stylesheet.card_height - (77 * face_factor(1)) + back_face_hint_offset_top() }
		width: 		{ 30 * face_factor(1) + back_face_hint_offset_width() }
		height: 	{ 12 * face_factor(1) + back_face_hint_offset_height() }
		alignment: 	bottom right
		visible: 	{ not back_face_hint_disabled()  and is_notched()}
		font:
			name: 	ModMatrix
			size: 	{ 12 * face_factor(1) }
			weight: bold
			color: 	{ back_face_hint_color() }
			stroke color:  { back_face_hint_stroke_color() }
			stroke radius: { back_face_stroke_radius() }
			separator color: red
			
	node:
		left: 		0
		top: 		0
		width: 		{ stylesheet.card_width }
		height: 	{ stylesheet.card_height }
		render style: image
		z index: 	610
		image: 		{ module_node() }
		visible:	{ not transform_symbol_is_empty(card.transformation) and not node_disabled() }

	meld bar:
		left:		0
		top:		0
		width:		{ stylesheet.card_width }
		height:		{ stylesheet.card_height }
		z index:	1100
		mask:		{ meld_bar_mask(face:1, field:1) }
		visible:	{ use_meld_bar() }
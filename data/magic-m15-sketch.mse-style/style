extra card style:
	pt box:
		left:				0
		top:				0
		width:				{ stylesheet.card_width }
		height:				{ stylesheet.card_height }
		z index:			800
		render style:		image
		image:
			script:
				if card.pt == "" then "" else (
				pure := pure_colors()
				count := length(pure)
				color := pt_colors()
				if color == "gold" and count > 1 then template("m", type: "pt")
				else if color == "land" and count > 1 then template("c", type: "pt")
				else if color == "hybrid" and count == 2 then masked_blend(mask: "special_blend_pt.png", dark: template(pure.0, type: "pt"), light: template(pure.1, type: "pt"))
				else card_ptbox())
	alias box:
		left:				0
		top:				0
		width:				{ stylesheet.card_width }
		height:				{ stylesheet.card_height }
		z index:			190
		visible:			{ card.alias != "" }
		render style:		image
		image:				{ module_alias() }
	transform scribble:
		left:				0
		top:				0
		width:				{ stylesheet.card_width }
		height:				{ stylesheet.card_height }
		z index:			230
		visible:			{ not transform_symbol_is_empty(card.transformation) }
		render style:		image
		image:				{ if transform_symbol_is_right(card.transformation) then flip_image("transform_scribble.png", horizontal: true) else "transform_scribble.png" }

card style:
	############################# Background stuff
	card color:
		left:				0
		top:				0
		width:				{ stylesheet.card_width }
		height:				{ stylesheet.card_height }
		z index:			200
		popup style:		in place
		render style:		image
		image:				{ color_blend(type: if styling.clear_frame then "clearcard" else "card") }
		mask:				card_mask.png
	alias:
		left:				173
		top:				115
		width:				404
		height:				33
		alignment:			center middle shrink-overflow
		z index:			900
		font:
			name:				MPlantin-Italic
			size:				{ alias_font_size(face:1) + 1 }
			style:				bold
			weight:				bold
			color:				white
	############################# Image
	image:
		left:				{ art_left() }
		top:				{ art_top() }
		width:				{ art_width() }
		bottom:				{ art_bottom() }
		z index:			100
		mask:				{ art_mask() }
		store in metadata:	{ is_crowned() or card.alias != "" }
	mainframe image:
		left:				{ popout_left() }
		top:				{ popout_top() }
		width:				{ popout_width() }
		height:				{ popout_height() }
		z index:			1000
		store in metadata: true
	############################# Text box
	text:
		left:				55
		top:				{ 668 + chop_top() + body_font_vertical() }
		right:				{ 681 - chop_right() }
		bottom:				{ 957 - (if reminder_box_is_visible() then 24 else if is_stamped() then 10 else 0) - chop_bottom() }
		z index:			900
		line height hard:	1.2
		line height line:	1.5
		line height soft:	0.9
		line height hard max:	1.3
		line height line max:	1.6
		alignment:
			script:
				if (styling.center_text == "short text only" and
				   not contains(match:"\n", card.rule_text) and
				   card.flavor_text == "<i-flavor></i-flavor>" and
				   card_style.text.content_lines <= 2) or
				   styling.center_text == "always"
				then "middle center"
				else "middle left"
		font:
			name:				{ body_font() }
			italic name:		{ body_font_italic() }
			size:				{ body_font_size() }
			scale down to:		7
			color:				{ body_font_color() }
		symbol font:
			name:				{ styling.text_box_mana_symbols }
			size:				{ body_font_size() }
			scale down to:		7
	############################# PT
	pt:
		left:				587
		top:				{ 950 + pt_font_vertical() }
		width:				131
		height:				45
		z index:			900
		alignment:			center middle shrink-overflow
		font:
			name:				{ pt_font() }
			size:				{ pt_font_size() }
			color:				{ pt_font_color() }
			separator color:	red
	############################# Transform reminder
	reminder type:
		left:				{ reminder_type_left() }
		top:				{ reminder_type_top() }
		width:				{ if reminder_disabled() or reminder_type_disabled() then 0 else reminder_type_width() }
		height:				{ reminder_type_height() }
		angle:				-1.6
		z index:			910
		alignment:			left middle shrink-overflow
		#alignment:			{ if remove_tags(card.reminder_cost) != "" then "left middle shrink-overflow" else "center middle shrink-overflow" }
		font:
			name:				{ reminder_type_font() }
			size:				{ reminder_type_font_size() }
			scale down to:		6
			color:				{ reminder_type_font_color() }
		symbol font:
			name:				{ reminder_type_symbol_font() }
			size:				{ reminder_type_symbol_font_size() }
			scale down to:		6
	reminder cost:
		right:				{ reminder_cost_right() }
		top:				{ reminder_cost_top() }
		width:				{ if reminder_disabled() or reminder_cost_disabled() then 0 else reminder_cost_width() }
		height:				{ reminder_cost_height() }
		angle:				-1.8
		z index:			911
		alignment:			right middle shrink-overflow
		font:
			name:				{ reminder_cost_font() }
			size:				{ reminder_cost_font_size() }
			scale down to:		6
			color:				{ reminder_cost_font_color() }
		symbol font:
			name:				{ reminder_cost_symbol_font() }
			size:				{ reminder_cost_symbol_font_size() }
			scale down to:		6
	reminder box:
		left:				{ reminder_box_left() }
		top:				{ reminder_box_top() }
		width:				{ reminder_box_width() }
		height:				{ reminder_box_height() }
		z index:			830
		visible:			{ reminder_box_is_visible() }
		render style:		image
		image:				{ reminder_box_image() }


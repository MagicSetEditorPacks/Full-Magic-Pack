saga_chapter_move_1 :=		{ split := split_comma(styling.move_chapter_icons);		if length(split) > input-1 and split[input-1] != "" and split[input-1] != "-" then clamp(split[input-1], maximum:700, minimum:-700) else 0 }
saga_separator_move_1 :=	{ split := split_comma(styling.move_separators);		if length(split) > input-1 and split[input-1] != "" and split[input-1] != "-" then clamp(split[input-1], maximum:500, minimum:-500) else 0 }
saga_textbox_move_1 :=		{ split := split_comma(styling.move_textbox_bottoms);	if length(split) > input   and split[input  ] != "" and split[input  ] != "-" then clamp(split[input  ], maximum:500, minimum:-500) else 0 }

saga_abilities_count_1 :=	{ to_int(styling.number_of_textboxes) }

saga_textbox_heights_1 :=
{
	active_count := saga_abilities_count_1() - 1
	total_available_height := saga_text_height_1()
	
	#### This specifies how much text dictates the height of a textbox. 100 Percent means all textboxes have the same height, regardless of their text content.
	#### 0 percent means textboxes have a height directly proportional to their text content. (For ex: a textbox with twice as many characters will be twice as high.)
	ability_balance_percentage := styling.ability_balance_percentage or else "30"
	ability_balance_importance := if ability_balance_percentage == "" then 0.3 else clamp(ability_balance_percentage, minimum: 0, maximum: 100) / 100
	
	#### This specifies how much chapter icons dictate the height of a textbox. 100 Percent means chapter icons will be very spaced out.
	#### 0 percent means chapter icons will overlap (only if there is not enough space).
	chapter_spacing_percentage := styling.chapter_spacing_percentage or else "50"
	chapter_spacing_importance := if chapter_spacing_percentage == "" then 1.0 else clamp(chapter_spacing_percentage, minimum: 0, maximum: 100) / 50
	
	#### A chaptertrain is the set of all chapter icons that are on the same ability. (Up to 8 abilities, so 8 chaptertrains.)
	chapter_indexes := saga_chapter_indexes_1(active_count: active_count)
	chaptertrain_0_count := 0
	chaptertrain_1_count := 0
	chaptertrain_2_count := 0
	chaptertrain_3_count := 0
	chaptertrain_4_count := 0
	chaptertrain_5_count := 0
	chaptertrain_6_count := 0
	chaptertrain_7_count := 0
	#### Put each chapter icon in it's chapter train
	for c from 0 to saga_chapter_max_count_1()-1 do
	(
		if		chapter_indexes[c] == -1 then	(0)
		else if	chapter_indexes[c] == 0 then	(chaptertrain_0_count := chaptertrain_0_count + 1)
		else if	chapter_indexes[c] == 1 then	(chaptertrain_1_count := chaptertrain_1_count + 1)
		else if	chapter_indexes[c] == 2 then	(chaptertrain_2_count := chaptertrain_2_count + 1)
		else if	chapter_indexes[c] == 3 then	(chaptertrain_3_count := chaptertrain_3_count + 1)
		else if	chapter_indexes[c] == 4 then	(chaptertrain_4_count := chaptertrain_4_count + 1)
		else if	chapter_indexes[c] == 5 then	(chaptertrain_5_count := chaptertrain_5_count + 1)
		else if	chapter_indexes[c] == 6 then	(chaptertrain_6_count := chaptertrain_6_count + 1)
		else									(chaptertrain_7_count := chaptertrain_7_count + 1)
	)
	chaptertrain_counts := [chaptertrain_0_count, chaptertrain_1_count, chaptertrain_2_count, chaptertrain_3_count, chaptertrain_4_count, chaptertrain_5_count, chaptertrain_6_count, chaptertrain_7_count]
	chaptertrain_desired_heights :=	for x from 0 to active_count do [chaptertrain_counts[x] * (saga_chapter_height_1() + saga_chapter_spacing_1()) * chapter_spacing_importance]
	
	#### Determine how much text is in each textbox. The ideal metric would be card_style.level_X_text.content_lines, but every time the card_style variable is used,
	#### everything breaks when the data is reloaded. The layout of the card changes, which is unacceptable. To counteract this, the less precise but more stable
	#### length(card.level_X_text) is used instead.
	character_counts :=				for x from 0 to active_count do [clamp(length(to_text(card["level_" + (x+1) + "_text"])), minimum: 20, maximum: 1000)]
	total_character_count :=		for x from 0 to active_count do character_counts[x]
	total_character_average :=		total_character_count / (active_count + 1)
	balanced_character_counts :=	for x from 0 to active_count do [total_character_average * ability_balance_importance + character_counts[x] * (1 - ability_balance_importance)]
	text_desired_heights :=			for x from 0 to active_count do [total_available_height*balanced_character_counts[x]/total_character_count]
	
	textbox_desired_heights :=		for x from 0 to active_count do [max(text_desired_heights[x], chaptertrain_desired_heights[x])]
	
	total_desired_height :=			for x from 0 to active_count do textbox_desired_heights[x]
	
	missing := ( total_desired_height - total_available_height ) / ( active_count + 1 )
	factor := total_available_height / total_desired_height
	
	#### When resizing, always make small textboxes as big as possible, to make for a more balanced looking card
	textbox_effective_heights :=	if missing <= 0 then	(for x from 0 to active_count do [textbox_desired_heights[x] - missing])	#### When increasing size, add equally to each textbox
									else					(for x from 0 to active_count do [textbox_desired_heights[x] * factor])		#### When decreasing size, do it in percentage, taking away more from big textboxes
	
	textbox_effective_heights
}


#### Showcase-compatible base rarity slots
#### sub-slots are defined at the bottom
#### because they're pretty useless from the user's end without weights
pack type:
	name: common
	filter: card.rarity == "common"
	select: proportional
	item:
		name: common without showcase
		weight: 5
	item:
		name: common with showcase
		weight: 4
	item:
		name: common showcase
		weight: 1

pack type:
	name: uncommon
	filter: card.rarity == "uncommon"
	select: proportional
	item:
		name: uncommon without showcase
		weight: 5
	item:
		name: uncommon with showcase
		weight: 4
	item:
		name: uncommon showcase
		weight: 1

pack type:
	name: mythic rare or rare
	filter: card.rarity == "rare" or card.rarity == "mythic rare"
	select: equal proportional
	item:
		name: mythic rare
		weight: 1
	item:
		name: rare
		weight: 2


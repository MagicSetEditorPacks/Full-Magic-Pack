	given := margin_top_user(level)
	if level == 0 or not leveler_enabled() or level > max_supported_levels or line_count(card["level_{level}_text"]) > 1 then 0
	else if given != "" then given
	else margin_top_triage()
}
## check if we need to add/remove margins
margin_top_triage := {
	## if there's 1 liners we always want to pad those
	## if there's 5 or fewer lines we may want to pad that too, but less important
	## if neither then we're in danger of causing problems instead of fixing them, just remove the margins
	total_height := card_style.text.height
	lines_ar := []
	one_liner := 0
	six_lines := 0
	blocks := for each b in card_style.text.layout.blocks do (
		l_count := if b.height == 0 then 0 else length(b.lines)
		if l_count == 1 then one_liner := 1
		six_lines := six_lines + l_count
		lines_ar := lines_ar + [l_count]
		if b.height == 0 then 0 else 1
	)
	if blocks < 2 then 0 else if one_liner == 0 and six_lines >= 6 then 0 else to_int(margin_top_calc())
}
## calculate the margin
margin_top_calc := {
	lines := for each l in card_style.text.layout.lines do (if l.height == 0 then 0 else 1)
	
	lhs := card_style.text.line_height_soft
	lhl := card_style.text.line_height_line - lhs
	
	line_height := card_style.text.layout.lines[0].height
	lines_height := ((lines * lhs) + (blocks * lhl)) * line_height
	
	remainder := total_height - lines_height
	margins := [0]
	
	minipad := to_int(6 * leveler_coord_factor())
	
	## prioritize 1 liners that are smaller than the arrow
	for x from 1 to max_supported_levels-1 do (
		pad := 0
		if (lines_ar[x] or else 0) == 1 and remainder > minipad then (
			pad := minipad
			remainder := remainder - pad
		)
		margins := margins + [pad]
	)
	## divide the remainder evenly
	pad := if remainder <= 0 then 0 else to_int(remainder / last_active_level())
	base := if level == 0 then 0 ## idk what is causing this
	else if level == 1 then min(5, pad / 3)
	else min(15, (margins[level-1] or else 0) + pad)
	leveler_coord_factor() * base
}
margin_top_user := {
	margins := split_comma(styling.level_padding or else "")
	if level == 0 or length(margins) < level or margins[level-1] == "" then ""
	else (
		given := to_int(to_number_lax(margins[level-1]))
		if given < 0 then "" else given
	)
}

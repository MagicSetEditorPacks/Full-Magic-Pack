		mask: {if is_rare() then "foil_mask_rare.png" else "foil_mask.png"}
	stamp backing:
		left: 165
		top: 477
		width: 46
		height: 26
		visible: {card.card_stamp != "none"}
		render style: image
		z index: 850
		image: { "/magic-modules.mse-include/stamps/backs/" + (if stamp_shape() == "triangle" then "triangle_" else "") + "stamp.png" }
	transform left:
		left:				5
		top:				23
		width:				49
		height:				37
		z index:			500
		visible:			{ (not transform_symbol_is_empty(card.transformation)) and (not transform_symbol_is_right(card.transformation)) }
		render style:		image
		image:				{ card_transforml(type: "transform_left" + if transform_symbol_is_modal(card.transformation) then "_modal" else "") }
	transform right:
		left:				321
		top:				23
		width:				48
		height:				36
		z index:			520
		visible:			{ (not transform_symbol_is_empty(card.transformation)) and (transform_symbol_is_right(card.transformation)) }
		render style:		image
		image:				{ card_transformr(type: "transform_right" + if transform_symbol_is_modal(card.transformation) then "_modal" else "") }

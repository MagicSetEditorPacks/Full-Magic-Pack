		mask: { if is_rare() then "foil_mask_rare.png" else "foil_mask.png" }
	crown:
		left: 0
		top: 0
		width: 375
		height: 523
		render style: image
		image: {crown_background()}
		z index: 5
		visible: {is_legend()}
	back:
		left: 0
		top: 0
		width: 375
		height: 523
		render style: image
		image: {hedron_background()}
		z index: -1

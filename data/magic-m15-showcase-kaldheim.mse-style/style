	casting_cost_offset_top_1 := { 2 }
	
	alias_offset_left_1 := { 0 }
	alias_offset_top_1 := { if is_crowned() then 7 else -17 }
	alias_offset_width_1 := { -110 }
	
	nameline_character_limit := { 38 - length(replace(to_text(card.casting_cost), match:"/", replace:"")) * 1.5 - if transform_symbol_is_empty(card.transformation) then 0 else 2 }
	swap_fonts_name_default :=
	[
		name: {"Beleren Bold"},
		size: {30.0 - max(0, (length(to_text(card.name)) - nameline_character_limit()) / 2)},
		color: {"white"},
		vertical: {0},
		italic: {""}
	]

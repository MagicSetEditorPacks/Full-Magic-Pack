############################################################## Update
update cards script:
	before version: 2026-08-24
	description: Migrate vorthos box
	script:
		new_stylesheet := "magic-m15-adventure.mse-style"
		new_version := "2026-08-24"
		reqs := [[new_stylesheet, new_version]]
		if not has_required_stylesheets(reqs)
			then []
		else (
			was_reversed := chosen(styling.other_options, choice:"reversed")
			styling_data := []
			if was_reversed then styling_data := [
				other_options: remove_choice(styling.other_options, choice:"reversed"),
				left_style: styling.right_style,
				right_style: styling.left_style
			]
			[
				new_card(
					copy_from: card,
					[
						styling_data: styling_data,
						vorthos_box: card.vorthos_box,
						watermark: if card.watermark_3 != "none" then card.watermark_3 else card.watermark
					]
				)
			]
		)

############################################################## Extra scripts
init script:
	# Load scripts for image box
	include file: /magic-default-image.mse-include/scripts
	include file: /magic-modules.mse-include/dfc/init_script
	default_is_back := is_back_face
	is_back_face := { not is_spot() and default_is_back() }

	# Should hybrids have a grey name?
	mask_hybrid_with_land := { styling.grey_hybrid_name }
	
	#Should multicolor lands with basic land types have a colored name?
	mask_multi_land_with_color := { styling.colored_multicolor_land_name }
	
	template_prefix := [
		card: "/magic-modules.mse-include/cards/375 m15 simple/",
		ubcard: "/magic-modules.mse-include/cards/375 m15 simple/beyond/",
		devoid: "/magic-modules.mse-include/cards/375 m15 simple/devoid/",
		double_page: "/magic-modules.mse-include/pages/double_page/",
		double_omen: "/magic-modules.mse-include/pages/double_omen/",
		single_page: "/magic-modules.mse-include/pages/single_page/",
		single_omen: "/magic-modules.mse-include/pages/single_omen/",
		null_page: "/magic-modules.mse-include/pages/null_page/",
		double_flat: "/magic-modules.mse-include/pages/double_flat/",
		single_flat: "/magic-modules.mse-include/pages/single_flat/",
		binding: "binding/",
		pt: "/magic-modules.mse-include/pts/375 m15/",
		stamp: "/magic-modules.mse-include/stamps/backs/375 round/",
		ubstamp: "/magic-modules.mse-include/stamps/backs/375 ub/",
		spot: "spotlight/",
		spotpt: "spotlight/",
		spotpage: "spotlight/",
		crown: "/magic-modules.mse-include/crowns/375/",
		nyx: "/magic-modules.mse-include/trims/nyx/",
		snow: "/magic-modules.mse-include/trims/snow/",
		alias: "/magic-modules.mse-include/extras/alias/",
		star: "/magic-modules.mse-include/trims/star/",
		identity: "/magic-modules.mse-include/indicators/"
	]
	template_suffix := [
		card: "card.jpg",
		ubcard: "card.jpg",
		devoid: "card.png",
		double_page: "page.png",
		single_page: "page.png",
		null_page: "page.png",
		double_omen: "omen.png",
		single_omen: "omen.png",
		double_flat: "page.png",
		single_flat: "page.png",
		binding: "block.jpg",
		pt: "pt.png",
		stamp: "stamp.png",
		ubstamp: "stamp.png",
		spot: "card.png",
		spotpt: "pt.png",
		spotpage: "card2.png",
		crown: "crown.png",
		nyx: "nyx.png",
		alias: "alias.png",
		snow: "snow.png",
		star: "star.png",
		identity: "identity.png"
	]
	template := template_mainframe
	land_template := land_template_mainframe

	landless_blend_types := [
		"double_flat", "single_flat",
		"double_page", "single_page", "null_page",
		"double_omen", "single_omen",
		"spot", "spotpage", "spotpt"
		"binding","nyx", "devoid",
		"stamp", "ubstamp"
	]
	# Use land templates for previews because they show more contrast
	hybrid_previews := "land,hybrid"

	null_page_blend := { color_background(type:"null_page", base_hybrid:card_hybrid, folder:template_prefix["null_page"]) }
	single_page_blend := { color_background(type:"single_page", base_hybrid:card_hybrid, folder:template_prefix["single_page"]) }
	single_omen_blend := { color_background(type:"single_omen", base_hybrid:card_hybrid, folder:template_prefix["single_omen"]) }
	double_page_blend := { color_background(type:"double_page", base_hybrid:card_hybrid, folder:template_prefix["double_page"]) }
	double_omen_blend := { color_background(type:"double_omen", base_hybrid:card_hybrid, folder:template_prefix["double_omen"]) }
	binding_background := { color_background(type:"binding", base_hybrid:card_hybrid, folder:"blend_masks/") }
	double_flat_page_blend := { color_background(type:"double_flat", base_hybrid:card_hybrid, folder:template_prefix["double_flat"]) }
	single_flat_page_blend := { color_background(type:"single_flat", base_hybrid:card_hybrid, folder:template_prefix["single_flat"]) }
	page_spread_blend := { color_background(type:"pages", base_hybrid:card_hybrid, folder:"blend_masks/") }
	decoration_background := { color_background(type:"decoration", base_hybrid:card_hybrid, artifact_blend:"white", hybrid_blend:"white", multicolor_blend:"white") }

	spot_background := { color_background(type:"spot", base_hybrid:card_hybrid, folder:"blend_masks/") }
	spot_page_background := { color_background(type:"spotpage", base_hybrid:card_hybrid, folder:"blend_masks/") }
	spot_pt := { color_background(type:"spotpt", base_hybrid:card_hybrid, folder:"blend_masks/") }

	beyond_background := { color_background(type:"ubcard", base_hybrid: card_hybrid, folder:template_prefix["card"], blend_type:"card")}
	devoid_background := { color_background(type:"devoid", base_hybrid: card_hybrid, folder:template_prefix["card"], blend_type:"card")}
	
	#### Legend Crown
	module_crown_mask := {
		if not transform_symbol_is_empty(card.transformation) then node_mask() else ""
	}

	base_card_img := {
		image := if is_spot()
			then spot_background()
		else if is_devoid()
			then devoid_background()
		else if is_clear()
			then template_prefix["card"] + "xcard.png"
		else if is_beyond()
			then beyond_background()
		else module_card()
		if is_clear() then input := "colorless"
		
		if is_back_face() or is_borderless() then
			image := color_multiply(width:375, height:523, multiply_mask:if is_spot() then "" else template_prefix["card"] + "hybrid_blend_card.png")
		if is_borderless() then (
			image := insert_image(
				base_image: set_mask(mask:"frame_masks/borderless" + ".png"),
				inserted_image: "transparent_borderless.png",
				offset_x: 0,
				offset_y: 0
			)
		)
		image
	}
	ptbox_img := {
		image := if is_spot() then spot_pt() else module_ptbox(vehicle:is_vehicle())
		if is_back_face() then image := color_multiply(width:if is_spot() then 68 else 135, height:if is_spot() then 38 else 76)
		image
	}
	# Use the normal tap symbol
	mana_t := {
		if      styling.tap_symbol == "old"        then "old"
		else if styling.tap_symbol == "diagonal T" then "older"
		else                                            "new"
	}
	
	# Use guild mana symbols?
	guild_mana := { styling.use_guild_mana_symbols }
	
	# Is the card a promo card?
	is_promo := { styling.promo }
	is_spot := {contains(styling.frames, match:"Spotlight")}
	is_legend :=	{ not is_spot() and auto_legend() }
	is_vehicle :=	{ not is_spot() and (auto_vehicle()	or chosen(styling.frames, choice:"vehicle")) }
	is_nyx :=		{ not is_spot() and (auto_nyx()		or chosen(styling.frames, choice:"nyx")) }
	is_snow :=		{ not is_spot() and (auto_snow()	or chosen(styling.frames, choice:"snow")) }
	is_beyond := 	{ not is_spot() and (auto_ub()		or chosen(styling.frames, choice:"universes beyond")) }
	is_devoid :=    { not is_spot() and chosen(styling.frames, choice:"devoid") }
	is_clear :=     { not is_spot() and chosen(styling.frames, choice:"clear") }
	is_borderless := { not is_spot() and chosen(styling.frames, choice:"borderless") }
	clear_pages :=  { is_borderless() and not chosen(styling.other_options, choice:"use pages on borderless") }
	uses_clear_frame := { not is_spot() and (chosen(styling.frames, choice:"clear") or chosen(styling.frames, choice:"devoid")) }
	auto_legend :=	{ set.auto_legends								and lang_setting("is_legendary")(card.super_type) }
	auto_vehicle := { chosen(styling.auto_frames, choice:"vehicle")	and lang_setting("is_vehicle")(card.sub_type) }
	auto_nyx :=		{ 
		is_ench := lang_setting("is_enchantment")(card.super_type)
		if not is_ench
			then false ## not an enchantment
		else if not set.auto_nyx
			then false ## set auto disabled
		else if not chosen(styling.auto_frames, choice:"nyx")
			then false ## style auto disabled
		else true      ## auto nyx
	}
	auto_snow :=	{ contains(styling.auto_frames, match:"snow")		and lang_setting("is_snow")(card.super_type) }
	auto_ub :=		{ contains(styling.auto_frames, match:"universes beyond")		and (card.card_stamp == "universes beyond" or card.card_stamp == "flatstamped universes beyond") }
	
	##### flavor bar stuff
	chop_correction := { chop_bot() }
	top_of_textbox := {327-(-chop_top())}
	bottom_of_textbox := {(if is_spot() then 464 else 481)-chop_bot()}

	top_of_textbox2 := {375-(-back_chop_top())}
	bottom_of_textbox2 := {(if is_spot() then 464 else 481)-back_chop_bot()}
	
	chop_top := {to_number(pull_comma_array(styling.chop_main, cell:0, end:false))}
	chop_bot := {to_number(pull_comma_array(styling.chop_main, cell:1, end:false))}
	back_chop_top := {to_number(pull_comma_array(styling.chop_adventure, cell:0, end:false))}
	back_chop_bot := {to_number(pull_comma_array(styling.chop_adventure, cell:1, end:false))}
	back_chop_right := {to_number(pull_comma_array(styling.chop_adventure, cell:2, end:false))}
	##### backface bar
	flavor_text2 := {remove_tags(card.flavor_text_2) + "\n"}
	chop_correction2 := { 0 }
	is_unsorted := {styling.remove_from_autocount}
	
	shrink_abstract := {
		spl := split_comma(styling["shrink_{input}_text"])
		if page == 3 and length(spl) >= 3 then to_number_lax(spl.2)
		else if page > 1 then to_number_lax(spl.1 or else 0)
		else to_number_lax(spl.0)
	}
	
	shrink_name := { shrink_abstract("name", page:1) }
	shrink_name2 := { shrink_abstract("name", page:2) }
	shrink_name3 := { shrink_abstract("name", page:3) }
	
	shrink_type := { shrink_abstract("typeline", page:1) }
	shrink_type2 := { shrink_abstract("typeline", page:2) }
	shrink_type3 := { shrink_abstract("typeline", page:3) }
	
	use_evobar := {contains(styling.other_options, match:"pokemon evobar")}
	is_skinned := {card.alias != ""}

	card_shape := {"adventure"}

	### Customize fonts
	swap_fonts_name_default := [
		name: {"Beleren Bold"},
		size: {16},
		color: {if is_back_face() or is_borderless() then "white" else "black"},
		vertical: {0},
		italic: {""}
	]
	swap_fonts_name2_default := [
		name: {"Beleren Bold"},
		size: {12},
		color: {"white"},
		vertical: {0},
		italic: {""}
	]
	name3_font_size := {
		swap_font_size(
			src: swap_fonts_name2_src(), 
			font_size: swap_fonts_name2_default.size()
		) - shrink_name3()
	}
	swap_fonts_type_default := [
		name: {"Beleren Bold"},
		size: {13},
		color: {if is_back_face() or is_borderless() then "white" else "black"},
		vertical: {0},
		italic: {""}
	]
	swap_fonts_type2_default := [
		name: {"Beleren Bold"},
		size: {11},
		color: {"white"},
		vertical: {0},
		italic: {""}
	]
	type3_font_size := {
		swap_font_size(
			src: swap_fonts_type2_src(), 
			font_size: swap_fonts_type2_default.size()
		) - shrink_type3()
	}
	swap_fonts_pt_default := [
		name: {"Beleren Bold"},
		size: {16},
		color: {if is_vehicle() or is_back_face() then "white" else "black"},
		vertical: {0},
		italic: {""}
	]
	swap_fonts_body_default := [
		name: {"MPlantin"},
		size: {13},
		color: {if is_borderless() and (clear_pages() or page_null(input) or page_flat(input)) then "white" else "black"},
		vertical: {0},
		italic: {"MPlantin-Italic"}
	]
	
	page_decoration_template := {
		src := "/magic-mainframe-extras.mse-include/"
		str := styling.page_decoration
		if not contains(str, match:".png") then (
			src := ""
			str := ""
		)

		c := ""
		pt := ""
		l := ""
		
		if contains(str, match:";color") then c := input
			
		if contains(str, match:";pt")
		and (right_name() and card.pt != "") then pt := "_pt";
		
		if land and contains(str, match:";land") then l := "l"
		
		replace(
			str,
			match:"([^;]*/)?([^/;]+)([.]png)(;.+)?",
			replace:{src + _1 + c + l + _2 + pt + _3}
		)
	}
	
	page_script := {
		if clear_pages() then input := replace(match:"page|omen|flat", replace:"borderless")
		flip := if input == "none"
			then false
		else if input == "blank page" then
			if side == "left" then true else false
		else if side == "right" then
			true
		else false;

		adj_color := if flip then (
			if chosen(color, choice:"reversed")
				then replace(color, match:", reversed", replace:"")
			else color + ", reversed"
		) else color

		img := case input of
			"name and type borderless": "/magic-modules.mse-include/pages/borderless_double.png",
			"name and type page": double_page_blend(adj_color),
			"name and type omen": double_omen_blend(adj_color),
			"name and type flat": mask_dblflat(double_flat_page_blend(adj_color)),
			"name borderless": "/magic-modules.mse-include/pages/borderless_single.png",
			"name page": single_page_blend(adj_color),
			"name omen": single_omen_blend(adj_color),
			"name flat": mask_sngflat(single_flat_page_blend(adj_color)),
			"blank page": null_page_blend(adj_color),
			else: "";

		if flip then flip_horizontal(img) else img
	}
	mask_dblflat := {
		if no_divider() then
			set_mask(image: input, mask:"double_mask.png")
		else input
	}
	mask_sngflat := {
		if no_divider() then
			set_mask(image:input, mask:"single_mask.png")
		else input
	}
	named_page := contains@(match:"name")
	left_name := {
		style_check := if is_spot() then "name and type page" else styling.left_style
		named_page(style_check)
	}
	right_name := {
		style_check := if is_spot() then "none" else styling.right_style
		named_page(style_check)
	}
	left_page_img := {
		page_script(
			if is_spot() then "name and type page" else styling.left_style,
			color: (if left_name() then card.card_color_2 else card.card_color),
			side: "left"
		)
	}
	right_page_img := {
		page_script(
			if is_spot() then "none" else styling.right_style,
			color: (if right_name() then (if left_name() then card.card_color_3 else card.card_color_2) else card.card_color),
			side: "right"
		)
	}
	
	page_1_side := {
		## the main text of the card
		## two pages, gone
		## left side page, on the right
		## right side page or no pages, on the left
		if left_name() and right_name() then "none"
		else if left_name() then "right"
		else "left"
	}
	page_2_side := {
		## the adventure text of the card
		## two pages, left
		## left side page, left
		## right side page, right
		## no pages, gone
		if left_name() then "left"
		else if right_name() then "right"
		else "none"
	}
	page_3_side := {
		## the second adventure text of the card
		## two pages, right
		## else, gone
		if left_name() and right_name() then "right"
		else if left_name() == right_name() then "right"
		else "none"
	}
	page_wild_side := {
		## things that can be either on the main text or the second page
		## ie: the watermark and blank page
		if left_name() then "right"
		else "left"
	}

	is_omen := {
		str := if input == "none" then ""
			else styling[input + "_style"]
		
		if contains(str, match:"omen") then
			true
		else false
	}
	
	page_style := {
		str := if input == "none" then ""
			else styling[input + "_style"]
			
		if is_spot() then
			"double"
		else if contains(str, match:"type") and is_omen() then
			"omen_double"
		else if contains(str, match:"type") then
			"double"
		else if contains(str, match:"name") and is_omen() then
			"single"
		else if contains(str, match:"name") then
			"single"
		else if is_omen() then
			"null"
		else "null"
	}
	page_flat := {
		str := if input == "none" then ""
			else styling[input + "_style"]
			
		if is_spot() then false else contains(str, match:"flat")
	}
	page_1_flat := {page_flat(page_1_side())}
	page_2_flat := {page_flat(page_2_side())}
	page_3_flat := {page_flat(page_3_side())}
	page_omen := {
		str := if input == "none" then ""
			else styling[input + "_style"]
			
		if is_spot() then false else contains(str, match:"omen")
	}
	page_1_omen := {page_omen(page_1_side())}
	page_2_omen := {page_omen(page_2_side())}
	page_3_omen := {page_omen(page_3_side())}
	page_null := {
		str := if input == "none" then ""
			else styling[input + "_style"]
		if is_spot() then false else contains(str, match:"none")
	}
	page_top := [
		"double": 375,
		"omen_double": 375,
		"single": 358,
		"omen_single": 358,
		"null": 332,
	]
	page_1_top := {page_top[page_style(page_1_side())]}
	page_2_top := {page_top[page_style(page_2_side())]}
	page_3_top := {page_top[page_style(page_3_side())]}
	page_wild_top := {page_top[page_style(page_wild_side())]}
	page_coords := [
		"left": [
			"page": 18,
			"name_left": 32,
			"name_right": 178,
			"cost": 180,
			"type": 32,
			"text": 27,
			"decoration": 0,
			"flavor bar": 10,
			"watermark": 20,
			"spot_watermark": 30
		],
		"right": [
			"page": 188,
			"name_left": 197,
			"name_right": 347,
			"cost": 345,
			"type": 197,
			"text": 190,
			"decoration": 175,
			"flavor bar": 175
			"watermark": 188,
			"spot_watermark": 195
		],
		"none": [
			"page": 500,
			"name_left": 500,
			"name_right": -10,
			"cost": 500,
			"type": 500,
			"text": 500,
			"decoration": 500,
			"flavor bar": 500
			"watermark": 500,
			"spot_watermark": 500
		]
	]
	### adjust the right hand page
	right_page_adjust_cost := {
		righty := if input == 2 then (page_2_side() == "right") else (page_3_side() == "right")
		if not righty
			then 0
		else if clear_pages()
			then -2
		else if page_omen("right")
			then 4
		else 0
	}
	right_page_adjust_name := {
		righty := if input == 2 then (page_2_side() == "right") else (page_3_side() == "right")
		if not righty
			then 0
		else if clear_pages()
			then -2
		else if page_omen("right")
			then 4
		else 0
	}
	
	no_divider := {chosen(styling.other_options, choice:"no flat page divider")}
	#### transform symbol
	transform_symbol_offset_top_1 := { -1 }
	#### modal dfc flags
	reminder_disabled := { not is_linked_dfc() }
	#### Transform Node mirroring
	node_color := { if uses_clear_frame() then "clear" else card.card_color }
	
	custom_border_image := {
		src := styling.custom_border_source
		ps := split_text(src, match:"-color-")
		if length(ps) > 1 then
			"/magic-mainframe-extras.mse-include/" + ps[0] + input + (if land then "l" else "") + ps[1]
		else
			"/magic-mainframe-extras.mse-include/" + src
	}
	custom_border_blend := { color_background(type:"custom_border",     base_hybrid:card_hybrid, folder:"blend_masks/") }
	is_custom_border := {
		if chosen(styling.frames, choice:"custom border")
			then has_png(styling.custom_border_source)
		else auto_custom_border()
	}
	# this goes at the very end
	module_crown_template_patch := {
		if is_clear() or is_devoid()
			then input := "x"
		module_crown_template(override: if is_borderless() then "borderless" else if is_nyx() then "nyx" else "")
	}
	old_alias_colors := alias_colors
	alias_colors := {
		if is_clear() or is_devoid()
			then rgb(232, 231, 231)
		else old_alias_colors()
	}
	template_alternate_scripts := [

card style:
	reminder type:
		left:				{ reminder_type_left() }
		top:				{ reminder_type_top() }
		width:				{ if reminder_disabled() or reminder_type_disabled() then 0 else reminder_type_width() }
		height:				{ reminder_type_height() }
		z index:			910
		alignment:			{ if remove_tags(card.reminder_cost) != "" then "left middle shrink-overflow" else "center middle shrink-overflow" }
		font:
			name:				{ reminder_type_font() }
			size:				{ reminder_type_font_size() }
			scale down to:		6
			color:				{ reminder_type_font_color() }
		symbol font:
			name:				{ reminder_type_symbol_font() }
			size:				{ reminder_type_symbol_font_size() }
			scale down to:		6
	reminder cost:
		right:				{ reminder_cost_right() }
		top:				{ reminder_cost_top() }
		width:				{ if reminder_disabled() or reminder_cost_disabled() then 0 else reminder_cost_width() }
		height:				{ reminder_cost_height() }
		z index:			911
		alignment:			right middle shrink-overflow
		font:
			name:				{ reminder_cost_font() }
			size:				{ reminder_cost_font_size() }
			scale down to:		6
			color:				{ reminder_cost_font_color() }
		symbol font:
			name:				{ reminder_cost_symbol_font() }
			size:				{ reminder_cost_symbol_font_size() }
			scale down to:		6

extra card field:
	type:				choice
	name:				reminder box
	description:		The box for the modal type and cost hints.
	show statistics:	false
	save value:			false
	editable:			false
	choice:				reminder box
extra card style:
	reminder box:
		left:				{ reminder_box_left() }
		top:				{ reminder_box_top() }
		width:				{ reminder_box_width() }
		height:				{ reminder_box_height() }
		z index:			830
		visible:			{ (remove_tags(card.reminder_type) != "" or remove_tags(card.reminder_cost) != "") and not reminder_disabled() }
		render style:		image
		image:				{ reminder_box_image() }

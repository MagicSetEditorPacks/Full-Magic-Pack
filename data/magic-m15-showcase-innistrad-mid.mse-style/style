			b: rgb(59, 54, 50),
			r: rgb(237, 65, 39),
			g: rgb(19, 108, 70),
			a: rgb(98, 117, 158),
			m: rgb(250, 217, 113),
			c: rgb(174, 118, 82)
		][input]
	}
	
	art_left :=
	{
				if		styling.image_location == "portrait only"					then	54
				else if	styling.image_location == "portrait + name"					then	47
				else if	styling.image_location == "portrait + name + type"			then	47
				else if	styling.image_location == "portrait + name + type + text"	then	47
				else if	styling.image_location == "portrait + type"					then	51
				else if	styling.image_location == "portrait + type + text"			then	47
				else																		0
	}
	art_top :=
	{
				if		styling.image_location == "portrait only"					then	113
				else if	styling.image_location == "portrait + name"					then	48
				else if	styling.image_location == "portrait + name + type"			then	48
				else if	styling.image_location == "portrait + name + type + text"	then	48
				else if	styling.image_location == "portrait + type"					then	113
				else if	styling.image_location == "portrait + type + text"			then	113
				else																		0
	}
	art_right :=
	{
				if		styling.image_location == "portrait only"					then	595
				else if	styling.image_location == "portrait + name"					then	604
				else if	styling.image_location == "portrait + name + type"			then	604
				else if	styling.image_location == "portrait + name + type + text"	then	604
				else if	styling.image_location == "portrait + type"					then	598
				else if	styling.image_location == "portrait + type + text"			then	598
				else																		646
	}
	art_bottom :=
	{
				if		styling.image_location == "portrait only"					then	501
				else if	styling.image_location == "portrait + name"					then	501
				else if	styling.image_location == "portrait + name + type"			then	562
				else if	styling.image_location == "portrait + name + type + text"	then	833
				else if	styling.image_location == "portrait + type"					then	562
				else if	styling.image_location == "portrait + type + text"			then	833
				else																		902
	}
	
	pure_colors :=
	{
		sort_text(
			order: if card_is_wedge(input) then "(wbgur)" else "(wubrg)",
			(if chosen(card.card_color, choice:"white")	then "w") +
			(if chosen(card.card_color, choice:"blue")	then "u") +
			(if chosen(card.card_color, choice:"black")	then "b") +
			(if chosen(card.card_color, choice:"red")	then "r") +
			(if chosen(card.card_color, choice:"green")	then "g")
		)
	}
	pt_colors := { if styling.PT_color_scheme == "canon" then pt_colors_canon() else styling.PT_color_scheme }

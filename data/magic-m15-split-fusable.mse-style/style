extra card style:
	girders:
		left:				31
		top:				13
		width:				482
		height:				345
		z index:			220
		render style:		image
		popup style:		in place
		image:				{ split_color_blend(type: "card", transition: 0.05) }
	namebox:
		left:				31
		top:				13
		width:				482
		height:				345
		z index:			230
		render style:		image
		image:
			script:
				image :=	if is_solid("name") and not (styling.namebox_solid_color == rgba(0,0,0,0))
							then recolor_image("namebox/solid/" + variant(room: false, arrows: is_arrows()) + ".png", color: styling.namebox_solid_color)
							else split_color_blend(type: "namebox", multicolor_blend: "black", hybrid_blend: hybrid_mask())
				set_alpha(image, alpha: get_alpha("name"))
	namepin:
		left:				31
		top:				13
		width:				482
		height:				345
		z index:			231
		render style:		image
		image:				{ split_color_blend(type: "namepin") }
	typebox:
		left:				31
		top:				13
		width:				482
		height:				345
		z index:			230
		render style:		image
		image:
			script:
				image :=	if is_solid("type") and not (styling.typebox_solid_color == rgba(0,0,0,0))
							then recolor_image("typebox/solid/" + variant(room: is_room(), arrows: is_arrows()) + ".png", color: styling.typebox_solid_color)
							else split_color_blend(type: "typebox", transition: if is_room() then 0.058 else 0.0001, multicolor_blend: "black", hybrid_blend: hybrid_mask())
				set_alpha(image, alpha: get_alpha("type"))
	typepin:
		left:				31
		top:				13
		width:				482
		height:				345
		z index:			231
		render style:		image
		image:				{ split_color_blend(type: "typepin", transition: if is_room() then 0.058 else 0.0001) }
	textbox:
		left:				31
		top:				13
		width:				482
		height:				345
		z index:			220
		render style:		image
		image:
			script:
				image :=	if is_solid("text") and not (styling.textbox_solid_color == rgba(0,0,0,0))
							then recolor_image("textbox/solid/" + variant(room: is_room(), arrows: false) + ".png", color: styling.textbox_solid_color)
							else split_color_blend(type: "textbox")
				set_alpha(image, alpha: get_alpha("text"))
	textpin:
		left:				31
		top:				13
		width:				482
		height:				345
		z index:			221
		render style:		image
		image:				{ split_color_blend(type: "textpin") }
	fusebox:
		left:				31
		top:				13
		width:				482
		height:				345
		z index:			230
		visible:			{ is_fuse() }
		render style:		image
		image:
			script:
				if is_solid("fuse") and not (styling.fusebox_solid_color == rgba(0,0,0,0))
				then recolor_image("fusebox/solid/normal.png", color: styling.fusebox_solid_color)
				else split_color_blend(type: "fusebox", transition: 0.058)
	fusepin:
		left:				31
		top:				13
		width:				482
		height:				345
		z index:			231
		visible:			{ is_fuse() }
		render style:		image
		image:				{ split_color_blend(type: "fusepin", transition: 0.058) }
	promo label:
		left:				50
		top:				177
		width:				{ if is_room() then 440 else 199 }
		height:				20
		alignment:			middle right
		visible:			{ contains(styling.other_options, match:"prerelease stamp") }
		z index:			1030
		font:
			name:				ModMatrix
			size:				12
			color:				rgb(223,169,41)
	promo label 2:
		left:				291
		top:				177
		width:				199
		height:				20
		alignment:			middle right
		visible:			{ contains(styling.other_options, match:"prerelease stamp") and not is_room() }
		z index:			1030
		font:
			name:				ModMatrix
			size:				12
			color:				rgb(223,169,41)
	stamp backing:
		left:				{ if stamp_shape() == "round" then 46 else 45 }
		top:				165
		width:				46
		height:				26
		z index:			850
		angle:				-90
		visible:			{ card.card_stamp != "none" }
		render style:		image
		image:				{ recolor_image("/magic-modules.mse-include/stamps/backs/" + (if stamp_shape() == "triangle" then "triangle_" else "") + "stamp_color.png", color: card.border_color) }
	texture:
		left:				31
		top:				13
		width:				241
		height:				345
		z index:			200
		visible:			{ not is_borderless() }
		render style:		image
		popup style:		in place
		image:
			script:
				if		left_clear()	then	"texture/x.png"
				else if	left_nyx()		then	module_nyx()
				else if	left_vehicle()	then	"/magic-modules.mse-include/trims/vehicle.png"
				else if	left_snow()		then	module_snow()
				else if	is_beyond()		then	beyond_background()
				else							texture_background()
		mask:				{ texture_mask("left") }
	texture 2:
		left:				272
		top:				13
		width:				241
		height:				345
		z index:			200
		visible:			{ not is_borderless() }
		render style:		image
		popup style:		in place
		image:
			script:
				if		right_clear()	then	"texture/x.png"
				else if	right_nyx()		then	module_nyx()
				else if	right_vehicle()	then	"/magic-modules.mse-include/trims/vehicle.png"
				else if	right_snow()	then	module_snow()
				else if	is_beyond()		then	beyond_background()
				else							texture_background()
		mask:				{ texture_mask("right") }
	pt box:
		left:				197
		top:				327
		width:				70
		height:				42
		z index:			720
		render style:		image
		image:				{ if left_vehicle() then "/magic-modules.mse-include/pts/375 m15/vpt.png" else module_ptbox() }
		visible:			{ card.pt != "" }
	pt box 2:
		left:				438
		top:				327

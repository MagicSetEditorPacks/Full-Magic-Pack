card style:
############################# Background stuff
	border color:
		left:			0
		top:			0
		width:			375
		height:			523
		radius: 		18
		left width:		17
		right width:	17
		top width:		17
		bottom width: 	18
		z index: 		500
		mask: 			{ "masks/" + (if is_legend() then "crown_border" else "border_mask") + (if card.border_color == rgb(200,200,200) then "_silver" else "") + ".png" }
		visible:		{ not is_borderless() }
	card color:
		left:			0
		top:			0
		width:			375
		height:			523
		z index:		200
		render style:	image
		popup style:	in place
		image:			{ card_image(if is_clear() then "colorless" else card.card_color) }
		mask:			masks/click_mask.png
	############################# Name line
	name:
		left:
			script:
				if card.card_symbol != "none" and transform_symbol_active_left(card.transformation)
					then 78
				else if transform_symbol_active_left(card.transformation)
					then 58
				else if card.card_symbol != "none"
					then 50
				else 32
		top: 		30
		right:  	{ 341 - card_style.casting_cost.content_width - (if transform_symbol_active_right(card.transformation) then 26 else 0) }
		height: 	{ 23- (0.5 * shrink_name())}
		alignment: 	bottom shrink-overflow
		z index: 	900
		padding bottom: 0
		font:
			name: 	Beleren Bold
			size: 	{16 - shrink_name()}
			color: 	{ if is_back_face() then "white" else "black" }
	alias:
		left:	{ if use_evobar() then (if is_saga() then 192 else 33) else 38.5 }
		top: 	{if use_evobar() then 58 else 55}
		width: 	{if use_evobar() then max(100, card_style.alias.content_width) else 298 }
		height: 20
		alignment: { (if use_evobar() then "" else "center") + "middle shrink-overflow"}
		padding bottom: 0
		z index: 900
		font:
			name: 	{if use_evobar() then "Matrix" else "MPlantin-Italic"}
			size: 	{if use_evobar() then 10 else 9}
			style:	{if use_evobar() then "italic" else "bold"}
			weight: {if use_evobar() then "italic" else "bold"}
			color: 	{if use_evobar() then "black" else "white"}

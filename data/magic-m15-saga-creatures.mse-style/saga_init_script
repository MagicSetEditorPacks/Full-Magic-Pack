	else "/magic-modules.mse-include/chapters/chapter_" + input + ".png"
}

saga_chapter_max_count_1 :=	{ 10 }

saga_separator_left_1 :=				{ map := face_coordinates_map(saga_face_1()); 25 * map.width/375 + map.left + saga_separator_offset_left_1() + (if input == 1 then saga_first_separator_offset_left_1() else 0) }
saga_separator_width_1 :=				{ map := face_coordinates_map(saga_face_1()); 178 * map.width/375 + saga_separator_offset_width_1() + (if input == 1 then saga_first_separator_offset_width_1() else 0) }
saga_separator_top_1 :=
